From e7d7d301166a26cd39bfb36b1ca226849531cae1 Mon Sep 17 00:00:00 2001
From: openmico_onvif <andrei.tanas@gmail.com>
Date: Tue, 27 Oct 2026 01:20:38 +0000
Subject: [PATCH 07/10] clk: ingenic: add T20 CGU driver

Clock tree from Ingenic's 3.10.14 soc-t20/common/clk. The PLLs are
read-only (both output dividers and the fractional part); muxes,
dividers and gates use the common Ingenic CGU code.
---
 drivers/clk/ingenic/Kconfig                 |  10 +
 drivers/clk/ingenic/Makefile                |   1 +
 drivers/clk/ingenic/t20-cgu.c               | 399 ++++++++++++++++++++
 include/dt-bindings/clock/ingenic,t20-cgu.h |  52 +++
 4 files changed, 462 insertions(+)
 create mode 100644 drivers/clk/ingenic/t20-cgu.c
 create mode 100644 include/dt-bindings/clock/ingenic,t20-cgu.h

diff --git a/drivers/clk/ingenic/Kconfig b/drivers/clk/ingenic/Kconfig
index f80ac4f29..9da7917f4 100644
--- a/drivers/clk/ingenic/Kconfig
+++ b/drivers/clk/ingenic/Kconfig
@@ -85,6 +85,17 @@ config INGENIC_CGU_X1830
 
 	  If building for a X1830 SoC, you want to say Y here.
 
+config INGENIC_CGU_T20
+	bool "Ingenic T20 CGU driver"
+	default MACH_T20
+	select INGENIC_CGU_COMMON
+	select RATIONAL
+	help
+	  Support the clocks provided by the CGU hardware on Ingenic T20
+	  and compatible SoCs.
+
+	  If building for a T20 SoC, you want to say Y here.
+
 config INGENIC_TCU_CLK
 	bool "Ingenic JZ47xx TCU clocks driver"
 	default MACH_INGENIC
