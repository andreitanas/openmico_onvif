#!/bin/sh
#
# Start uvcd (native UniFi Protect camera protocol) from the sdcard
#
# Stopping it with SIGTERM lets uvcd release the camera (libimp) cleanly.
#

DIR=/sdcard/uvc
LOG=/sdcard/var/log/uvcd.log
PIDFILE=/var/run/uvcd.pid

run_loop() {
	while true; do
		# Keep the log bounded on the sdcard.
		if [ -f $LOG ] && [ "$(wc -c < $LOG)" -gt 1048576 ]; then
			mv $LOG $LOG.1
		fi
		$DIR/uvcd -c $DIR/uvcd.conf >> $LOG 2>&1
		echo "uvcd exited with $?, restarting in 5 s" >> $LOG
		sleep 5
	done
}

case "$1" in
  start)
	[ -x $DIR/uvcd ] || exit 0
	# With VIDEO_CAPTURE=uvcd, S60camera starts it early; nothing to do then.
	if [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
		exit 0
	fi
	# A capturing uvcd owns the camera, so it runs even before adoption.
	if ! grep -q '^CAPTURE=1' $DIR/uvcd.conf &&
	   ! grep -q '^ADOPTION_TOKEN=..*' $DIR/uvcd.conf && [ ! -f $DIR/uvcd.state ]; then
		echo "uvcd: no ADOPTION_TOKEN in $DIR/uvcd.conf yet, not starting"
		exit 0
	fi
	mkdir -p /sdcard/var/log
	echo -n "Starting uvcd: "
	run_loop > /dev/null 2>&1 &
	echo $! > $PIDFILE
	echo "OK"
	;;
  stop)
	echo -n "Stopping uvcd: "
	[ -f $PIDFILE ] && kill "$(cat $PIDFILE)" 2>/dev/null
	rm -f $PIDFILE
	killall uvcd 2>/dev/null
	echo "OK"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
