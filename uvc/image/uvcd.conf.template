# uvcd configuration (KEY=value). On the camera: /config/uvc/uvcd.conf,
# imported from config/uvc/uvcd.conf on the SD card at boot when the card's
# copy differs.

# Protect finds the camera on the network and lists it as ready to adopt;
# adopting it there sends the camera Protect's host and a token, kept in
# /config/uvc/uvcd.state. Only to adopt without that (a camera on another
# subnet, where discovery doesn't reach): the Protect host, and a one-time
# token, valid ~60 minutes, from "mgmt.token" of
#   https://<NVR_HOST>/proxy/protect/api/cameras/manage-payload
# opened while logged in to Protect.
#NVR_HOST=
#ADOPTION_TOKEN=

# Name shown in Protect before it is renamed there (default: hostname)
#NAME=Wyze Cam

# kbit/s and keyframe interval (frames) of the 1080p and low-res streams
#HI_BITRATE=2000
#HI_GOP=50
#LO_BITRATE=300
#LO_GOP=25
#FPS=25
# Mounted upside down / mirrored (Protect's flip and mirror apply on top)
#FLIP_V=0
#FLIP_H=0

# Day/night switching points, in the ISP's exposure figure (larger is
# darker; see /proc/jz/isp/isp_info). Protect's custom night mode moves both.
#NIGHT_EXPOSURE=1200000
#DAY_EXPOSURE=800000

# Hardware watchdog timeout in seconds (0: off)
#WATCHDOG=60
# Restart camera from Protect reboots the Wyze
#ALLOW_REBOOT=1

LOG_FILE=/tmp/uvcd.log
# 0 error, 1 warn, 2 info, 3 debug
#LOG_LEVEL=2
