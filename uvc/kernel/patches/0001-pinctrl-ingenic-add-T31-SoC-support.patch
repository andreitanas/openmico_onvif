+	INGENIC_PIN_GROUP("uart2-data-c", t31_uart2_data_c, 2),
+	INGENIC_PIN_GROUP("uart2-data-a", t31_uart2_data_a, 2),
+	INGENIC_PIN_GROUP("i2c0-data", t31_i2c0, 1),
+	INGENIC_PIN_GROUP("i2c1-data-a", t31_i2c1_a, 2),
