From 514724d42e6655dd17690e987c79f279753fedca Mon Sep 17 00:00:00 2001
From: openmico_onvif <andrei.tanas@gmail.com>
Date: Tue, 27 Oct 2026 01:20:38 +0000
Subject: [PATCH 06/10] MIPS: ingenic: add T20 SoC and the Wyze Cam v2 board

MACH_T20 (MIPS32r1, like Ingenic's own T20 kernels), the T20_WYZE_CAM_V2
board choice, the 'ingenic,t20' machine match and the board's dtb entry.
The device tree files are kept outside the patches (uvc/kernel/dts).
---
 arch/mips/boot/dts/ingenic/Makefile | 1 +
 arch/mips/generic/board-ingenic.c   | 3 +++
 arch/mips/include/asm/bootinfo.h    | 1 +
 arch/mips/ingenic/Kconfig           | 9 +++++++++
 4 files changed, 14 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/Makefile b/arch/mips/boot/dts/ingenic/Makefile
index a34b37723..6c4662fc6 100644
--- a/arch/mips/boot/dts/ingenic/Makefile
+++ b/arch/mips/boot/dts/ingenic/Makefile
@@ -5,4 +5,5 @@ dtb-$(CONFIG_JZ4770_GCW0)	+= gcw0.dtb
 dtb-$(CONFIG_JZ4780_CI20)	+= ci20.dtb
 dtb-$(CONFIG_X1000_CU1000_NEO)	+= cu1000-neo.dtb
 dtb-$(CONFIG_X1830_CU1830_NEO)	+= cu1830-neo.dtb
+dtb-$(CONFIG_T20_WYZE_CAM_V2)	+= wyze-cam-v2.dtb
 dtb-$(CONFIG_MACH_T31)		+= thingino-t31.dtb
diff --git a/arch/mips/generic/board-ingenic.c b/arch/mips/generic/board-ingenic.c
index 8a70232dd..93e0377f9 100644
--- a/arch/mips/generic/board-ingenic.c
+++ b/arch/mips/generic/board-ingenic.c
@@ -24,6 +24,8 @@
 static __init char *ingenic_get_system_type(unsigned long machtype)
 {
 	switch (machtype) {
+	case MACH_INGENIC_T20:
+		return "T20";
 	case MACH_INGENIC_T31:
 		return "T31";
 	case MACH_INGENIC_X2100:
@@ -154,6 +156,7 @@ static const struct of_device_id ingenic_of_match[] __initconst = {
 	{ .compatible = "ingenic,x2000h", .data = (void *)MACH_INGENIC_X2000H },
 	{ .compatible = "ingenic,x2100", .data = (void *)MACH_INGENIC_X2100 },
 	{ .compatible = "ingenic,t31", .data = (void *)MACH_INGENIC_T31 },
+	{ .compatible = "ingenic,t20", .data = (void *)MACH_INGENIC_T20 },
 	{}
 };
 
diff --git a/arch/mips/include/asm/bootinfo.h b/arch/mips/include/asm/bootinfo.h
index 198f00594..3dcb7cb5b 100644
--- a/arch/mips/include/asm/bootinfo.h
+++ b/arch/mips/include/asm/bootinfo.h
@@ -87,6 +87,7 @@ enum ingenic_machine_type {
 	MACH_INGENIC_X2000H,
 	MACH_INGENIC_X2100,
 	MACH_INGENIC_T31,
+	MACH_INGENIC_T20,
 };
 
 extern char *system_type;
diff --git a/arch/mips/ingenic/Kconfig b/arch/mips/ingenic/Kconfig
index e04358673..998151514 100644
--- a/arch/mips/ingenic/Kconfig
+++ b/arch/mips/ingenic/Kconfig
@@ -44,6 +44,10 @@ config X1830_CU1830_NEO
 	bool "YSH & ATIL CU1830 Module with Neo backplane"
 	select MACH_X1830
 
+config T20_WYZE_CAM_V2
+	bool "Wyze Cam v2 (Ingenic T20)"
+	select MACH_T20
+
 endchoice
 
 config MACH_JZ4725B
@@ -78,6 +82,11 @@ config MACH_X1830
 	select SYS_HAS_CPU_MIPS32_R2
 	select SYS_SUPPORTS_HIGHMEM
 
+config MACH_T20
+	bool
+	select MIPS_CPU_SCACHE
+	select SYS_HAS_CPU_MIPS32_R1
+
 config MACH_T31
 	bool
 	select MIPS_CPU_SCACHE
