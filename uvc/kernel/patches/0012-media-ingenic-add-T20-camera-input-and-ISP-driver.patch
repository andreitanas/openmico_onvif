+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic T20 camera input (VIC) and ISP core: a parallel Bayer sensor in,
+ * NV12 out of two paths, each a video node: DS1 at the sensor's size (the
+ * main stream; the SoC has no full-resolution writer) and DS2 scaled down
+ * (the second stream). Black level, white balance (automatic from the
+ * ISP's statistics, or set by hand), a colour matrix, sRGB gamma and the
+ * colour space converter with brightness, contrast and saturation; the blocks that need
+ * calibration tables (shading, noise reduction, Iridix) are bypassed.
+ *
+ * Written from docs/t20-isp-hardware.md (openmico_onvif), which records the
+ * register map and sequences used here.
+ */
+
+#include <linux/clk.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#include <media/media-device.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+
+/* VIC */
+#define VIC_CONTROL		0x00
+#define VIC_CONTROL_START	BIT(0)
+#define VIC_CONTROL_REG_ENABLE	BIT(1)
+#define VIC_CONTROL_SAFE_RESET	BIT(3)
+#define VIC_RESOLUTION		0x04
+#define VIC_INTF_TYPE		0x0c
+#define VIC_INTF_DVP		3
+#define VIC_DB_CFG		0x10
+#define VIC_DB_VSYNC_LOW	BIT(0)
+#define VIC_DB_HSYNC_LOW	BIT(1)
+#define VIC_DB_RAW10		(1 << 17)
+#define VIC_GLOBAL_CFG		0x50
+
+/* ISP interrupt controller */
+#define IRQC_CLEAR		0x04
+#define IRQC_STATUS		0x0c
+#define IRQC_ENABLE		0x14
+#define IRQC_MASK		0x1c
+
+/* ISP core */
+#define ISP_ACTIVE_WIDTH	0x010
+#define ISP_ACTIVE_HEIGHT	0x014
+#define ISP_RGGB_START		0x018	/* 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR */
+#define ISP_CONFIG_BUFFER_MODE	0x030
+#define ISP_CONFIG_IN_VBLANK	2
+#define ISP_BYPASS_LOW		0x040
+#define ISP_BYPASS_HIGH		0x044
+#define ISP_BYPASS_SINTER	BIT(9)
+#define ISP_IRQ_SOURCE(n)	(0x080 + 4 * ((n) / 2))
+#define ISP_IRQ_SOURCE_SHIFT(n)	(((n) & 1) ? 16 : 0)
+#define ISP_IRQ_STATUS		0x0a0
+#define ISP_IRQ_CLEAR		0x0a4
+#define ISP_INPUT_PORT		0x100
+#define ISP_INPUT_PORT_DVP	0x00100001
+#define ISP_INPUT_MODE		0x130
+#define ISP_INPUT_SAFE_STOP	0
+#define ISP_INPUT_SAFE_START	1
+#define ISP_SINTER_THRESH(n)	(0x290 + 4 * (n))	/* two 8-bit bands each */
+#define ISP_SENSOR_OFFSET(n)	(0x140 + 4 * (n))	/* n: 0 R, 1 Gr, 2 Gb, 3 B */
+#define ISP_WB_GAIN(n)		(0x300 + 4 * (n))	/* the same order */
+#define ISP_WB_GAIN_ONE		0x100
+#define ISP_WB_GAIN_MAX		0xfff
+#define ISP_CCM_COEF(n)		(0x480 + 4 * (n))	/* row-major 3x3 */
+#define ISP_DS1_GAMMA		0x4e4
+#define ISP_DS2_GAMMA		0x4e8
+#define ISP_GAMMA_ENABLE	BIT(0)
+#define ISP_DS1_GAMMA_LUT	0x11000
+#define ISP_DS2_GAMMA_LUT	0x12000
+#define ISP_COEF_SIGN		BIT(15)		/* matrices: sign and magnitude, 1/256 */
+/* Colour space converters, DS1 at 0x680 and DS2 at 0x780 */
+#define ISP_DS1_CSC		0x680
+#define ISP_DS2_CSC		0x780
+#define CSC_COEF(n)		(4 * (n))		/* row-major 3x3 */
+#define CSC_OFFSET(n)		(0x24 + 4 * (n))	/* 11-bit two's complement */
+#define CSC_ENABLE		0x30
+#define ISP_CSC_MATRIX		BIT(0)
+#define ISP_CSC_FILTER		BIT(1)
+#define ISP_CSC_HDOWN		BIT(2)
+#define ISP_CSC_VDOWN		BIT(3)
+#define ISP_AWB_RG		0x858	/* 4.8 fixed point, 12 bits */
+#define ISP_AWB_BG		0x85c
+#define ISP_AWB_SUM		0x860	/* pixels counted */
+#define ISP_AWB_STATS_MODE	0x868
+#define ISP_AWB_STATS_RG_BG	1	/* R/G and B/G (0: G/R and G/B) */
+#define ISP_NOISE_PROFILE_LUT	0x1d00	/* 128 8-bit entries, by intensity */
+/* Output n's sharpening: on bit 0 (coring bits 3:2 at reset); strength */
+#define ISP_DS_SHARPEN(n)	(0x620 + 0x100 * (n))
+#define ISP_SHARPEN_ON		BIT(0)
+#define ISP_DS_SHARPEN_STRENGTH(n) (0x624 + 0x100 * (n))
+#define ISP_BYPASS_DS1_SHARPEN	BIT(27)
+#define ISP_BYPASS_DS2_SHARPEN	BIT(4)		/* in ISP_BYPASS_HIGH */
+
+/* DS2 scaler; tinc is input / output in 4.20 fixed point */
+#define ISP_DS2_SCALER		0x740
+#define SCALER_WIDTH		0x08
+#define SCALER_HEIGHT		0x0c
+#define SCALER_OWIDTH		0x10
+#define SCALER_OHEIGHT		0x14
+#define SCALER_HTINC		0x18
+#define SCALER_HCOEFSET		0x1c
+#define SCALER_VTINC		0x20
+#define SCALER_VCOEFSET		0x24
+#define ISP_DS2_HFILT		0x18000	/* 4 sets x 32 phases x 8 taps */
+#define ISP_DS2_VFILT		0x1a000
+
+/* Video DMA writers: Y and UV of DS1 and DS2 */
+#define ISP_DS1_Y_WRITER	0xc00
+#define ISP_DS1_UV_WRITER	0xc80
+#define ISP_DS2_Y_WRITER	0xd00
+#define ISP_DS2_UV_WRITER	0xd80
+#define WRITER_FORMAT		0x00
+#define WRITER_NV12		13
+#define WRITER_PLANE_UV		(1 << 6)
+#define WRITER_FRAME_WRITE	BIT(9)
+#define WRITER_SIZE		0x04
+#define WRITER_BANK0		0x08
+#define WRITER_BANKS		0x1c
+#define WRITER_LINE_OFFSET	0x20
+#define WRITER_AXI		0x24
+#define WRITER_AXI_ENABLE	BIT(1)
+
+/* Interrupt lines the output ends are routed to, and their sources */
+#define ISP_LINE_DS1_DONE	13
+#define ISP_SRC_DS1_DONE	50
+#define ISP_LINE_DS2_DONE	14
+#define ISP_SRC_DS2_DONE	53
+
+/*
+ * Bypassed: mirror, digital gain, frontend LUT, RAW frontend, defect pixel,
+ * frame stitch, temper, radial and mesh shading, Iridix, the whole FR path,
+ * and on DS1 crop, scaler, sharpen, logo. Kept: sensor offset, white
+ * balance, demosaic, colour matrix, DS1 gamma and colour space converter.
+ * Sinter is on or off with the noise reduction control. Bit 8 keeps its
+ * reset value. The DS2 path is bypassed but when it streams: then its
+ * scaler, gamma and colour space converter run.
+ */
+#define ISP_BYPASS_LOW_MIN	(BIT(1) | GENMASK(7, 3) | BIT(8) | \
+				 GENMASK(10, 9) | GENMASK(15, 13) | GENMASK(22, 18) | \
+				 GENMASK(25, 24) | GENMASK(28, 27))
+#define ISP_BYPASS_HIGH_MIN	GENMASK(6, 1)
+#define ISP_BYPASS_DS2_SCALER	BIT(2)
+#define ISP_BYPASS_DS2_RUN	(ISP_BYPASS_DS2_SCALER | BIT(3) | BIT(6))	/* + gamma, CSC */
+
+#define T20_ISP_CLK_RATE	100000000
+#define T20_ISP_MIN_BUFFERS	2
+#define T20_ISP_MIN_SIZE	64
+#define T20_ISP_SUB_WIDTH	640
+#define T20_ISP_SUB_HEIGHT	360
+
+/*
+ * The JX-F22's black level in the ISP's 12-bit units, measured at the
+ * shortest exposure: steady at every analog gain.
+ */
+#define T20_ISP_BLACK_LEVEL	40
+
+/*
+ * Sinter (spatial noise reduction) with a flat noise profile until the
+ * sensor is calibrated; the control sets the thresholds of all its bands
+ */
+#define T20_ISP_NOISE_PROFILE	32
+#define T20_ISP_CID_NOISE_REDUCTION	(V4L2_CID_USER_BASE + 0x1300)
+#define T20_ISP_NOISE_REDUCTION_DEFAULT	32
+#define T20_ISP_SHARPNESS_DEFAULT	0x30	/* the block's reset strength */
+
+/* Auto white balance: least pixels for a valid measure, damping (1/n per frame) */
+#define T20_ISP_AWB_MIN_PIXELS	10000
+#define T20_ISP_AWB_DAMPING	4
+
+/*
+ * DS1 gamma: the sRGB curve at 129 points, 12 bits, as
+ * round(4095 * srgb(i / 128)) with srgb(x) = 12.92 x below 0.0031308 and
+ * 1.055 x^(1 / 2.4) - 0.055 above.
+ */
+static const u16 t20_isp_gamma_srgb[129] = {
+	   0,  347,  538,  679,  794,  894,  982, 1062, 1136, 1204,
+	1268, 1329, 1386, 1441, 1493, 1543, 1591, 1638, 1683, 1726,
+	1768, 1809, 1849, 1888, 1926, 1962, 1998, 2034, 2068, 2102,
+	2135, 2168, 2199, 2231, 2261, 2292, 2321, 2351, 2379, 2408,
+	2436, 2463, 2490, 2517, 2543, 2570, 2595, 2621, 2646, 2670,
+	2695, 2719, 2743, 2767, 2790, 2813, 2836, 2859, 2881, 2903,
+	2925, 2947, 2969, 2990, 3011, 3032, 3053, 3074, 3094, 3114,
+	3134, 3154, 3174, 3194, 3213, 3232, 3252, 3271, 3289, 3308,
+	3327, 3345, 3363, 3382, 3400, 3418, 3435, 3453, 3471, 3488,
+	3505, 3523, 3540, 3557, 3574, 3590, 3607, 3624, 3640, 3656,
+	3673, 3689, 3705, 3721, 3737, 3753, 3769, 3784, 3800, 3815,
+	3831, 3846, 3861, 3876, 3891, 3906, 3921, 3936, 3951, 3966,
+	3980, 3995, 4009, 4024, 4038, 4053, 4067, 4081, 4095,
+};
+
+/*
+ * Colour matrix (linear RGB, 1/256) until the sensor is calibrated: a
+ * saturation of 1.6 around BT.709 luma, s * I + (1 - s) * [w; w; w] with
+ * w = (0.2126, 0.7152, 0.0722). The raw JX-F22 colours are flat without it.
+ */
+static const s16 t20_isp_ccm[9] = {
+	377, -110, -11,
+	-33,  300, -11,
+	-33, -110, 399,
+};
+
+/*
+ * RGB to BT.601 YCbCr, 10 bits, in 1/256. Full range (JPEG's, the default):
+ * offsets 0 and 512. Limited range: Y rows scaled by 876/1023, Cb and Cr by
+ * 896/1023, offsets 64 and 512.
+ */
+static const s16 t20_isp_bt601_full[9] = {
+	 77, 150,  29,
+	-43, -85, 128,
+	128, -107, -21,
+};
+
+static const s16 t20_isp_bt601_lim[9] = {
+	 66, 129,  25,
+	-38, -74, 112,
+	112, -94, -18,
+};
+
+/*
+ * DS2 scaler filters: 7 taps (in 1/64) for each of 32 phases, sets for
+ * downscaling by up to 1.25, 1.67, 2.5 and more. Hann-windowed sinc, half
+ * width 3.5 taps, cut off at 1, 3/4, 1/2 and 1/3 of the input's Nyquist
+ * frequency. Phase p puts the output at tap 3.5 - p / 32 (horizontal); the
+ * vertical filter takes the taps in the reverse order.
+ */
+static const s8 t20_isp_scaler_filters[4][32][7] = {
