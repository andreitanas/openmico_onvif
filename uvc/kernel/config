# Wyze Cam v2 kernel configuration: applied on top of `make tinyconfig`
# (kernel/build.sh). Only what the camera uses; everything else stays at
# tinyconfig's "off".

## Platform: Ingenic T20, MIPS32 little-endian
# The vendor kernel is built for MIPS32r1 (OpenMiko's config): r1 code is
# safe whatever the core's r2 support turns out to be.
CONFIG_MACH_INGENIC_SOC=y
CONFIG_T20_WYZE_CAM_V2=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32_R1=y
CONFIG_HZ_100=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
# 4 KB pages, as the closed libimp/uvcd binaries expect
CONFIG_PAGE_SIZE_4KB=y

## Boot: device tree linked into the kernel, command line from it
# Vendor U-Boot passes argc/argv, not a DTB; its arguments are ignored.
CONFIG_MIPS_NO_APPENDED_DTB=y
CONFIG_MIPS_CMDLINE_FROM_DTB=y
CONFIG_KERNEL_XZ=y
CONFIG_BLK_DEV_INITRD=n

## Core kernel features userspace needs
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=n
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=n
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FILE_LOCKING=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# /dev/mem: libimp maps the ISP and encoder memory (ispmem/rmem) through it
CONFIG_DEVMEM=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_MAGIC_SYSRQ=y
# 16 KB of log; the default 128 KB ring costs ~0.5 MB of kernel image
CONFIG_LOG_BUF_SHIFT=14
CONFIG_BASE_SMALL=y
CONFIG_HW_RANDOM=n

## Interrupts, clocks, timers (mainline Ingenic drivers; T20 CGU is ours)
CONFIG_INGENIC_CGU_T20=y
CONFIG_INGENIC_TCU_CLK=y
CONFIG_INGENIC_TIMER=y
CONFIG_INGENIC_SYSOST=y
CONFIG_INGENIC_OST=n

## Console: UART1 (ttyS1), 115200
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_SERIAL_8250_INGENIC=y
CONFIG_SERIAL_OF_PLATFORM=n
CONFIG_SERIAL_EARLYCON=y

## Pins and GPIOs (IR cut filter 25/26, IR LEDs 49, USB power 47, sensor
## reset 18 through /sys/class/gpio; status LEDs through /sys/class/leds)
CONFIG_PINCTRL_INGENIC=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

## Watchdog (uvcd arms /dev/watchdog)
CONFIG_WATCHDOG=y
CONFIG_JZ4740_WDT=y

## SPI NOR flash on the SFC, partitions from the device tree
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_INGENIC_SFC=y
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
# Erase in 32 KB blocks like the vendor kernel: the config partition is a
# JFFS2 image with 32 KB erase blocks (our patch 0010)
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=n
CONFIG_MTD_SPI_NOR_USE_32K_SECTORS=y

## SD card and SDIO (MSC0, MSC1)
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_JZ4740=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MQ_IOSCHED_DEADLINE=n
CONFIG_MQ_IOSCHED_KYBER=n
CONFIG_IOSCHED_BFQ=n

## I2C (image sensor, for the ISP port)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_JZ4780=y

## V4L2 and the media controller, as modules: the ISP driver (open-tx-isp,
## being ported) registers subdevices, video nodes and controls with them
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n

## Filesystems: squashfs root, JFFS2 config partition, vfat SD card
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_FS_WRITEBUFFER=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

## Networking: IPv4/IPv6 over WiFi
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# IPv6 as a module (330 KB), loaded at boot by S20wifi
CONFIG_IPV6=m
CONFIG_INET_DIAG=n
CONFIG_IPV6_SIT=n
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
# Modules, loaded with the WiFi driver: keeps the kernel under 5 MB raw
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
# Signed regdb checking pulls RSA and X.509 into the kernel
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=n
CONFIG_CFG80211_CRDA_SUPPORT=n
# 8189fs uses its own MLME through cfg80211; no mac80211
CONFIG_MAC80211=n
CONFIG_WIRELESS=y
CONFIG_RFKILL=n
# WPA crypto runs in wpa_supplicant and the driver; no kernel crypto

## Off: what tinyconfig might leave on and the camera doesn't have
CONFIG_INPUT=n
CONFIG_VT=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_PCI=n
CONFIG_SWAP=n
CONFIG_SUSPEND=n
