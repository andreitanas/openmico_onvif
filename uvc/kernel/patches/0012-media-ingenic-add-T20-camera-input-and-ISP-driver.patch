+		{   0,   1,  11,  23,  21,   8,   0 },
+		{   0,   2,  11,  24,  20,   7,   0 },
+		{   0,   2,  12,  23,  20,   7,   0 },
+		{   0,   2,  12,  23,  20,   7,   0 },
+		{   0,   2,  13,  24,  19,   6,   0 },
