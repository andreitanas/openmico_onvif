+
+enum { T20_ISP_PAD_SINK, T20_ISP_PAD_SOURCE, T20_ISP_PAD_SOURCE_SUB, T20_ISP_PADS };
+
+/* Sensor Bayer orders, in the order of the ISP's RGGB start codes */
+static const u32 t20_isp_bayer[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10, MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10, MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+/* The RGGB start code of a Bayer format; BGGR, the sensor's default, if none */
+static u32 t20_isp_rggb_start(u32 code)
+{
+	u32 i;
+
+	for (i = 0; i < ARRAY_SIZE(t20_isp_bayer) - 1; i++)
+		if (t20_isp_bayer[i] == code)
+			break;
+	return i;
+}
+
+struct t20_isp_buffer {
+	struct vb2_v4l2_buffer vb;
+	struct list_head list;
+};
+
+enum { T20_ISP_MAIN, T20_ISP_SUB, T20_ISP_PATHS };
+
+/* An output path: DMA writers, interrupt and video node */
+struct t20_isp_path {
+	struct t20_isp *isp;
+	const char *name;
+	u32 y_writer, uv_writer;
+	unsigned int line, source;	/* output end interrupt */
+	unsigned int pad;		/* the ISP subdevice's source pad */
+
+	struct video_device vdev;
+	struct media_pad vpad;
+	struct vb2_queue queue;
+	struct mutex lock;		/* video device and queue */
+	struct v4l2_pix_format pix;
+	bool streaming;			/* read by the interrupt handler */
+
+	spinlock_t buf_lock;		/* the fields below */
+	struct list_head pending;
+	struct t20_isp_buffer *active;	/* being written by the hardware */
+	u32 sequence;
+};
+
+struct t20_isp {
+	struct device *dev;
+	void __iomem *vic;
+	void __iomem *irqc;
+	void __iomem *core;
+	struct clk *clk_isp;
+	struct clk *clk_core;
+	int irq;
+
+	struct media_device mdev;
+	struct v4l2_device v4l2_dev;
+	struct v4l2_async_notifier notifier;
+	struct v4l2_fwnode_endpoint ep;
+	struct v4l2_subdev *sensor;
+	u16 sensor_pad;
+
+	struct v4l2_subdev sd;
+	struct media_pad pads[T20_ISP_PADS];
+
+	struct t20_isp_path paths[T20_ISP_PATHS];
+	struct mutex hw_lock;		/* the fields below */
+	unsigned int streaming;		/* paths streaming */
+	u32 width, height;		/* the sensor's frame */
+	u32 rggb_start;			/* the sensor's Bayer order */
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *awb;		/* cluster: auto, red, blue */
+	struct v4l2_ctrl *red;
+	struct v4l2_ctrl *blue;
+	struct v4l2_ctrl *brightness;	/* cluster: brightness, contrast, saturation */
+	struct v4l2_ctrl *contrast;
+	struct v4l2_ctrl *saturation;
+	bool awb_on;			/* read by the interrupt handler */
+	int wb_red, wb_blue;		/* the AWB's gains, 4.8 fixed point */
+};
+
+static void isp_write(struct t20_isp *isp, u32 reg, u32 val)
+{
+	writel(val, isp->core + reg);
+}
+
+static u32 isp_read(struct t20_isp *isp, u32 reg)
+{
+	return readl(isp->core + reg);
+}
+
+static void isp_update(struct t20_isp *isp, u32 reg, u32 mask, u32 val)
+{
+	isp_write(isp, reg, (isp_read(isp, reg) & ~mask) | (val & mask));
+}
+
+/* Hardware programming */
+
+static u32 t20_isp_coef(int c)
+{
+	return min(abs(c), 0x7fff) | (c < 0 ? ISP_COEF_SIGN : 0);
+}
+
+static void t20_isp_set_wb(struct t20_isp *isp, int red, int blue)
+{
+	isp_write(isp, ISP_WB_GAIN(0), red);
+	isp_write(isp, ISP_WB_GAIN(1), ISP_WB_GAIN_ONE);
+	isp_write(isp, ISP_WB_GAIN(2), ISP_WB_GAIN_ONE);
+	isp_write(isp, ISP_WB_GAIN(3), blue);
+}
+
+/*
+ * A path's colour space converter, for its range: brightness adds to Y (in
+ * 8-bit steps), contrast (128 = 1) scales Y around mid grey, saturation
+ * (128 = 1) scales Cb and Cr.
+ */
+static void t20_isp_set_csc(struct t20_isp_path *path)
+{
+	struct t20_isp *isp = path->isp;
+	bool lim = path->pix.quantization == V4L2_QUANTIZATION_LIM_RANGE;
+	const s16 *m = lim ? t20_isp_bt601_lim : t20_isp_bt601_full;
+	int contrast = isp->contrast->val, saturation = isp->saturation->val;
+	u32 base = path == &isp->paths[T20_ISP_MAIN] ? ISP_DS1_CSC : ISP_DS2_CSC;
+	int i, c, black = lim ? 64 : 0, grey = lim ? 438 : 512, y_offset;
+
+	for (i = 0; i < 9; i++) {
+		c = m[i] * (i < 3 ? contrast : saturation) / 128;
+		isp_write(isp, base + CSC_COEF(i), t20_isp_coef(c));
+	}
+	y_offset = black + grey * (128 - contrast) / 128 + isp->brightness->val * 4;
+	isp_write(isp, base + CSC_OFFSET(0), clamp(y_offset, -1024, 1023) & 0x7ff);
+	isp_write(isp, base + CSC_OFFSET(1), 512);
+	isp_write(isp, base + CSC_OFFSET(2), 512);
+}
+
+/* Noise reduction: 0 bypasses Sinter */
+static void t20_isp_set_sinter(struct t20_isp *isp, int thresh)
+{
+	int i;
+
+	for (i = 0; i < 4; i++)
+		isp_write(isp, ISP_SINTER_THRESH(i), thresh | thresh << 16);
+	isp_update(isp, ISP_BYPASS_LOW, ISP_BYPASS_SINTER,
+		   thresh ? 0 : ISP_BYPASS_SINTER);
+}
+
+/* Sharpening of both outputs: 0 bypasses it */
+static void t20_isp_set_sharpen(struct t20_isp *isp, int strength)
+{
+	int n;
+
+	for (n = 0; n < 2; n++) {
+		isp_update(isp, ISP_DS_SHARPEN_STRENGTH(n), 0xff, strength);
+		isp_update(isp, ISP_DS_SHARPEN(n), ISP_SHARPEN_ON, strength ? ISP_SHARPEN_ON : 0);
+	}
+	isp_update(isp, ISP_BYPASS_LOW, ISP_BYPASS_DS1_SHARPEN,
+		   strength ? 0 : ISP_BYPASS_DS1_SHARPEN);
+	isp_update(isp, ISP_BYPASS_HIGH, ISP_BYPASS_DS2_SHARPEN,
+		   strength ? 0 : ISP_BYPASS_DS2_SHARPEN);
+}
+
+/*
+ * Grey world: the statistics are R/G and B/G after the gains, before the
+ * colour matrix. Each frame moves the red and blue gains part of the way to
+ * where the averages would be grey.
+ */
+static void t20_isp_awb(struct t20_isp *isp)
+{
+	int rg = isp_read(isp, ISP_AWB_RG) & 0xfff;
+	int bg = isp_read(isp, ISP_AWB_BG) & 0xfff;
+	int r = isp->wb_red, b = isp->wb_blue;
+
+	if (isp_read(isp, ISP_AWB_SUM) < T20_ISP_AWB_MIN_PIXELS || !rg || !bg)
+		return;
+	r += (r * ISP_WB_GAIN_ONE / rg - r) / T20_ISP_AWB_DAMPING;
+	b += (b * ISP_WB_GAIN_ONE / bg - b) / T20_ISP_AWB_DAMPING;
+	isp->wb_red = clamp(r, ISP_WB_GAIN_ONE / 4, ISP_WB_GAIN_MAX);
+	isp->wb_blue = clamp(b, ISP_WB_GAIN_ONE / 4, ISP_WB_GAIN_MAX);
+	t20_isp_set_wb(isp, isp->wb_red, isp->wb_blue);
+}
+
+static void t20_isp_set_buffer(struct t20_isp_path *path, struct t20_isp_buffer *buf)
+{
+	struct t20_isp *isp = path->isp;
+	dma_addr_t y;
+
+	if (!buf) {
+		isp_update(isp, path->y_writer + WRITER_FORMAT, WRITER_FRAME_WRITE, 0);
+		isp_update(isp, path->uv_writer + WRITER_FORMAT, WRITER_FRAME_WRITE, 0);
+		return;
+	}
+	y = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+	isp_write(isp, path->y_writer + WRITER_BANK0, y);
+	isp_write(isp, path->uv_writer + WRITER_BANK0,
+		  y + path->pix.bytesperline * path->pix.height);
+	isp_update(isp, path->y_writer + WRITER_FORMAT, WRITER_FRAME_WRITE,
+		   WRITER_FRAME_WRITE);
+	isp_update(isp, path->uv_writer + WRITER_FORMAT, WRITER_FRAME_WRITE,
+		   WRITER_FRAME_WRITE);
+}
+
+static u32 t20_isp_pack_taps(const s8 *t)
+{
+	return (u8)t[0] | (u8)t[1] << 8 | (u8)t[2] << 16 | (u32)(u8)t[3] << 24;
+}
+
+static void t20_isp_load_scaler_filters(struct t20_isp *isp)
+{
+	unsigned int set, phase, k;
+	s8 v[8];
+	u32 at;
+
+	for (set = 0; set < ARRAY_SIZE(t20_isp_scaler_filters); set++) {
+		for (phase = 0; phase < 32; phase++) {
+			const s8 *h = t20_isp_scaler_filters[set][phase];
+
+			at = 0x100 * set + 8 * phase;
+			memcpy(v, h, 7);
+			v[7] = 0;
+			isp_write(isp, ISP_DS2_HFILT + at, t20_isp_pack_taps(v));
+			isp_write(isp, ISP_DS2_HFILT + at + 4, t20_isp_pack_taps(v + 4));
+			for (k = 0; k < 7; k++)
+				v[k] = h[6 - k];
+			isp_write(isp, ISP_DS2_VFILT + at, t20_isp_pack_taps(v));
+			isp_write(isp, ISP_DS2_VFILT + at + 4, t20_isp_pack_taps(v + 4));
+		}
+	}
+}
+
+/* The filter set for downscaling by in / out */
+static u32 t20_isp_scaler_coefset(u32 in, u32 out)
+{
+	if (in * 4 <= out * 5)
+		return 0;
+	if (in * 3 <= out * 5)
+		return 1;
+	if (in * 2 <= out * 5)
+		return 2;
+	return 3;
+}
+
+static void t20_isp_set_scaler(struct t20_isp *isp, u32 base, u32 w, u32 h,
+			       u32 ow, u32 oh)
+{
+	isp_write(isp, base + SCALER_WIDTH, w);
+	isp_write(isp, base + SCALER_HEIGHT, h);
+	isp_write(isp, base + SCALER_OWIDTH, ow);
+	isp_write(isp, base + SCALER_OHEIGHT, oh);
+	isp_write(isp, base + SCALER_HTINC, (w << 20) / ow);
+	isp_write(isp, base + SCALER_HCOEFSET, t20_isp_scaler_coefset(w, ow));
+	isp_write(isp, base + SCALER_VTINC, (h << 20) / oh);
+	isp_write(isp, base + SCALER_VCOEFSET, t20_isp_scaler_coefset(h, oh));
+}
+
+/* Input, core and the settings both paths share; the input starts later */
+static void t20_isp_hw_start(struct t20_isp *isp)
+{
+	u32 w = isp->width, h = isp->height, cfg = VIC_DB_RAW10;
+	unsigned int flags = isp->ep.bus.parallel.flags;
+	int i;
+
+	/* VIC: parallel RAW10 in */
+	if (flags & V4L2_MBUS_VSYNC_ACTIVE_LOW)
+		cfg |= VIC_DB_VSYNC_LOW;
+	if (flags & V4L2_MBUS_HSYNC_ACTIVE_LOW)
+		cfg |= VIC_DB_HSYNC_LOW;
+	writel(VIC_INTF_DVP, isp->vic + VIC_INTF_TYPE);
+	writel(cfg, isp->vic + VIC_DB_CFG);
+	writel(w << 16 | h, isp->vic + VIC_RESOLUTION);
+	writel(0, isp->vic + VIC_GLOBAL_CFG);
+	writel(VIC_CONTROL_REG_ENABLE, isp->vic + VIC_CONTROL);
+	writel(VIC_CONTROL_START, isp->vic + VIC_CONTROL);
+
+	/* Core: geometry, pipeline */
+	isp_write(isp, ISP_CONFIG_BUFFER_MODE, ISP_CONFIG_IN_VBLANK);
+	isp_write(isp, ISP_INPUT_PORT, ISP_INPUT_PORT_DVP);
+	isp_write(isp, ISP_ACTIVE_WIDTH, w);
+	isp_write(isp, ISP_ACTIVE_HEIGHT, h);
+	isp_write(isp, ISP_RGGB_START, isp->rggb_start);
+	isp_write(isp, ISP_BYPASS_LOW, ISP_BYPASS_LOW_MIN);
+	isp_write(isp, ISP_BYPASS_HIGH, ISP_BYPASS_HIGH_MIN);
+	for (i = 0; i < 4; i++)
+		isp_write(isp, ISP_SENSOR_OFFSET(i), T20_ISP_BLACK_LEVEL);
+	isp_write(isp, ISP_AWB_STATS_MODE, ISP_AWB_STATS_RG_BG);
+	for (i = 0; i < ARRAY_SIZE(t20_isp_ccm); i++)
+		isp_write(isp, ISP_CCM_COEF(i), t20_isp_coef(t20_isp_ccm[i]));
+	for (i = 0; i < 128; i += 4)
+		isp_write(isp, ISP_NOISE_PROFILE_LUT + i, T20_ISP_NOISE_PROFILE * 0x01010101);
+	for (i = 0; i < ARRAY_SIZE(t20_isp_gamma_srgb); i++) {
+		isp_write(isp, ISP_DS1_GAMMA_LUT + 4 * i, t20_isp_gamma_srgb[i]);
+		isp_write(isp, ISP_DS2_GAMMA_LUT + 4 * i, t20_isp_gamma_srgb[i]);
+	}
+	isp_update(isp, ISP_DS1_GAMMA, ISP_GAMMA_ENABLE, ISP_GAMMA_ENABLE);
+	isp_update(isp, ISP_DS2_GAMMA, ISP_GAMMA_ENABLE, ISP_GAMMA_ENABLE);
+	isp_write(isp, ISP_DS1_CSC + CSC_ENABLE, ISP_CSC_MATRIX | ISP_CSC_FILTER |
+		  ISP_CSC_HDOWN | ISP_CSC_VDOWN);
+	isp_write(isp, ISP_DS2_CSC + CSC_ENABLE, ISP_CSC_MATRIX | ISP_CSC_FILTER |
+		  ISP_CSC_HDOWN | ISP_CSC_VDOWN);
+	t20_isp_load_scaler_filters(isp);
+
+	/* Interrupts: each path turns its line on */
+	isp_write(isp, ISP_IRQ_CLEAR, 0);
+	isp_write(isp, ISP_IRQ_CLEAR, 0xffff);
+	writel(GENMASK(22, 0), isp->irqc + IRQC_CLEAR);
+	writel(GENMASK(22, 0), isp->irqc + IRQC_MASK);
+	writel(0, isp->irqc + IRQC_ENABLE);
+}
+
+static void t20_isp_hw_stop(struct t20_isp *isp)
+{
+	isp_write(isp, ISP_INPUT_MODE, ISP_INPUT_SAFE_STOP);
+	writel(0, isp->irqc + IRQC_ENABLE);
+	writel(GENMASK(22, 0), isp->irqc + IRQC_MASK);
+	writel(VIC_CONTROL_SAFE_RESET, isp->vic + VIC_CONTROL);
+}
+
+/* Writers, DS2's blocks and the path's interrupt line; latched in vertical blanking */
+static void t20_isp_path_start(struct t20_isp_path *path)
+{
+	struct t20_isp *isp = path->isp;
+	u32 w = path->pix.width, h = path->pix.height, bypass = ISP_BYPASS_DS2_RUN;
+	u32 base, bit = BIT(path->line);
+
+	for (base = path->y_writer; base <= path->uv_writer; base += 0x80) {
+		isp_write(isp, base + WRITER_FORMAT, WRITER_NV12 |
+			  (base == path->uv_writer ? WRITER_PLANE_UV : 0));
+		isp_write(isp, base + WRITER_SIZE, w | h << 16);
+		isp_write(isp, base + WRITER_BANKS, 0);
+		isp_write(isp, base + WRITER_LINE_OFFSET, path->pix.bytesperline);
+		isp_write(isp, base + WRITER_AXI, WRITER_AXI_ENABLE);
+	}
+
+	t20_isp_set_csc(path);
+	if (path == &isp->paths[T20_ISP_SUB]) {
+		/* The scaler runs only to change the size */
+		if (w == isp->width && h == isp->height)
+			bypass &= ~ISP_BYPASS_DS2_SCALER;
+		else
+			t20_isp_set_scaler(isp, ISP_DS2_SCALER, isp->width, isp->height,
+					   w, h);
+		isp_update(isp, ISP_BYPASS_HIGH, bypass, 0);
+	}
+
+	isp_update(isp, ISP_IRQ_SOURCE(path->line),
+		   0x3f << ISP_IRQ_SOURCE_SHIFT(path->line),
+		   path->source << ISP_IRQ_SOURCE_SHIFT(path->line));
+	WRITE_ONCE(path->streaming, true);
+	writel(bit, isp->irqc + IRQC_CLEAR);
+	writel(readl(isp->irqc + IRQC_ENABLE) | bit, isp->irqc + IRQC_ENABLE);
+	writel(readl(isp->irqc + IRQC_MASK) & ~bit, isp->irqc + IRQC_MASK);
+}
+
+static void t20_isp_path_stop(struct t20_isp_path *path)
+{
+	struct t20_isp *isp = path->isp;
+	u32 bit = BIT(path->line);
+
+	WRITE_ONCE(path->streaming, false);
+	writel(readl(isp->irqc + IRQC_MASK) | bit, isp->irqc + IRQC_MASK);
+	writel(readl(isp->irqc + IRQC_ENABLE) & ~bit, isp->irqc + IRQC_ENABLE);
+	t20_isp_set_buffer(path, NULL);
+	if (path == &isp->paths[T20_ISP_SUB])
+		isp_update(isp, ISP_BYPASS_HIGH, ISP_BYPASS_DS2_RUN, ISP_BYPASS_DS2_RUN);
+}
+
+/* A frame out of the path: the next frame's address latches in this vertical blanking */
+static void t20_isp_path_done(struct t20_isp_path *path)
+{
+	struct t20_isp_buffer *done, *next = NULL;
+
+	spin_lock(&path->buf_lock);
+	done = path->active;
+	if (!list_empty(&path->pending)) {
+		next = list_first_entry(&path->pending, struct t20_isp_buffer, list);
+		list_del(&next->list);
+	}
+	path->active = next;
+	t20_isp_set_buffer(path, next);
+	spin_unlock(&path->buf_lock);
+
+	if (done) {
+		done->vb.vb2_buf.timestamp = ktime_get_ns();
+		done->vb.sequence = path->sequence;
+		done->vb.field = V4L2_FIELD_NONE;
+		vb2_buffer_done(&done->vb.vb2_buf, VB2_BUF_STATE_DONE);
+	}
+	path->sequence++;
+}
+
+static irqreturn_t t20_isp_irq(int irq, void *data)
+{
+	struct t20_isp *isp = data;
+	struct t20_isp_path *awb_path;
+	u32 pending, status;
+	int i;
+
+	pending = readl(isp->irqc + IRQC_STATUS) & ~readl(isp->irqc + IRQC_MASK);
+	if (!pending)
+		return IRQ_NONE;
+	writel(pending, isp->irqc + IRQC_CLEAR);
+
+	status = isp_read(isp, ISP_IRQ_STATUS);
+	isp_write(isp, ISP_IRQ_CLEAR, 0);
+	isp_write(isp, ISP_IRQ_CLEAR, status);
+
+	/* White balance once a frame, on the main path's end if it runs */
+	awb_path = &isp->paths[READ_ONCE(isp->paths[T20_ISP_MAIN].streaming) ?
+			       T20_ISP_MAIN : T20_ISP_SUB];
+	if (READ_ONCE(isp->awb_on) && (status & BIT(awb_path->line)))
+		t20_isp_awb(isp);
+
+	for (i = 0; i < T20_ISP_PATHS; i++)
+		if ((status & BIT(isp->paths[i].line)) &&
+		    READ_ONCE(isp->paths[i].streaming))
+			t20_isp_path_done(&isp->paths[i]);
+	return IRQ_HANDLED;
+}
+
+/* Video device and queue */
+
+static int t20_isp_sd_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt);
+
+/* Full range unless limited range is asked for */
+static void t20_isp_fill_pix(struct v4l2_pix_format *pix, u32 w, u32 h, u32 quantization)
+{
+	pix->width = ALIGN(w, 2);
+	pix->height = ALIGN(h, 2);
+	pix->pixelformat = V4L2_PIX_FMT_NV12;
+	pix->field = V4L2_FIELD_NONE;
+	pix->bytesperline = ALIGN(pix->width, 8);
+	/* Room past the frame for the JPEG encoder's whole 16-line macroblock rows */
+	pix->sizeimage = pix->bytesperline * ALIGN(pix->height, 16) * 3 / 2;
+	pix->colorspace = V4L2_COLORSPACE_SMPTE170M;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	pix->quantization = quantization == V4L2_QUANTIZATION_LIM_RANGE ?
+			    quantization : V4L2_QUANTIZATION_FULL_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+}
+
+static int t20_isp_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+			       unsigned int *nplanes, unsigned int sizes[],
+			       struct device *alloc_devs[])
+{
+	struct t20_isp_path *path = vb2_get_drv_priv(q);
+
+	if (*nplanes)
+		return sizes[0] < path->pix.sizeimage ? -EINVAL : 0;
+	*nplanes = 1;
+	sizes[0] = path->pix.sizeimage;
+	return 0;
+}
+
+static int t20_isp_buf_prepare(struct vb2_buffer *vb)
+{
+	struct t20_isp_path *path = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb2_plane_size(vb, 0) < path->pix.sizeimage)
+		return -EINVAL;
+	vb2_set_plane_payload(vb, 0, path->pix.sizeimage);
+	return 0;
+}
+
+static void t20_isp_buf_queue(struct vb2_buffer *vb)
+{
+	struct t20_isp_path *path = vb2_get_drv_priv(vb->vb2_queue);
+	struct t20_isp_buffer *buf =
+		container_of(to_vb2_v4l2_buffer(vb), struct t20_isp_buffer, vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&path->buf_lock, flags);
+	if (vb2_start_streaming_called(vb->vb2_queue) && !path->active) {
+		/* Writes were off for lack of buffers: on again from next frame */
+		path->active = buf;
+		t20_isp_set_buffer(path, buf);
+	} else {
+		list_add_tail(&buf->list, &path->pending);
+	}
+	spin_unlock_irqrestore(&path->buf_lock, flags);
+}
+
+static void t20_isp_return_buffers(struct t20_isp_path *path, enum vb2_buffer_state state)
+{
+	struct t20_isp_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&path->buf_lock, flags);
+	if (path->active)
+		list_add(&path->active->list, &path->pending);
+	path->active = NULL;
+	list_for_each_entry_safe(buf, tmp, &path->pending, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&path->buf_lock, flags);
+}
+
+/*
+ * The sensor's Bayer order changes with its mirror and flip: the ISP's sink
+ * takes the sensor's format before the links are validated
+ */
+static int t20_isp_sync_sensor_fmt(struct t20_isp *isp)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = isp->sensor_pad,
+	};
+	struct v4l2_subdev_state *state;
+	int ret;
+
+	ret = v4l2_subdev_call_state_active(isp->sensor, pad, get_fmt, &fmt);
+	if (ret)
+		return ret;
+	fmt.pad = T20_ISP_PAD_SINK;
+	state = v4l2_subdev_lock_and_get_active_state(&isp->sd);
+	t20_isp_sd_set_fmt(&isp->sd, state, &fmt);
+	v4l2_subdev_unlock_state(state);
+	isp->rggb_start = t20_isp_rggb_start(fmt.format.code);
+	return 0;
+}
+
+/*
+ * The first path to stream starts the hardware and the sensor, the last to
+ * stop stops them
+ */
+static int t20_isp_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct t20_isp_path *path = vb2_get_drv_priv(q);
+	struct t20_isp *isp = path->isp;
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&isp->hw_lock);
+	if (!isp->streaming) {
+		ret = t20_isp_sync_sensor_fmt(isp);
+		if (ret)
+			goto err_unlock;
+	}
+	ret = video_device_pipeline_alloc_start(&path->vdev);
+	if (ret)
+		goto err_unlock;
+
+	if (!isp->streaming) {
+		ret = pm_runtime_resume_and_get(isp->dev);
+		if (ret)
+			goto err_pipeline;
+		t20_isp_hw_start(isp);
+		ret = v4l2_ctrl_handler_setup(&isp->ctrls);
+		if (ret)
+			goto err_hw;
+	}
+
+	path->sequence = 0;
+	spin_lock_irqsave(&path->buf_lock, flags);
+	path->active = list_first_entry(&path->pending, struct t20_isp_buffer, list);
+	list_del(&path->active->list);
+	spin_unlock_irqrestore(&path->buf_lock, flags);
+	t20_isp_path_start(path);
+	t20_isp_set_buffer(path, path->active);
+
+	if (!isp->streaming) {
+		isp_write(isp, ISP_INPUT_MODE, ISP_INPUT_SAFE_START);
+		ret = v4l2_subdev_enable_streams(isp->sensor, isp->sensor_pad, BIT_ULL(0));
+		if (ret) {
+			t20_isp_path_stop(path);
+			goto err_hw;
+		}
+	}
+	isp->streaming++;
+	mutex_unlock(&isp->hw_lock);
+	return 0;
+
+err_hw:
+	if (!isp->streaming) {
+		t20_isp_hw_stop(isp);
+		pm_runtime_put(isp->dev);
+	}
+err_pipeline:
+	video_device_pipeline_stop(&path->vdev);
+err_unlock:
+	mutex_unlock(&isp->hw_lock);
+	t20_isp_return_buffers(path, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void t20_isp_stop_streaming(struct vb2_queue *q)
+{
+	struct t20_isp_path *path = vb2_get_drv_priv(q);
+	struct t20_isp *isp = path->isp;
+
+	mutex_lock(&isp->hw_lock);
+	t20_isp_path_stop(path);
+	if (!--isp->streaming) {
+		v4l2_subdev_disable_streams(isp->sensor, isp->sensor_pad, BIT_ULL(0));
+		t20_isp_hw_stop(isp);
+	}
+	synchronize_irq(isp->irq);
+	if (!isp->streaming)
+		pm_runtime_put(isp->dev);
+	mutex_unlock(&isp->hw_lock);
+	video_device_pipeline_stop(&path->vdev);
+	t20_isp_return_buffers(path, VB2_BUF_STATE_ERROR);
+}
