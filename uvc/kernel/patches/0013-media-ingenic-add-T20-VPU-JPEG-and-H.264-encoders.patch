+
+/* Bitstream headers */
+
+struct t20_h264_bits {
+	u8 *buf;
+	u32 pos;			/* in bits */
+};
+
+static void t20_h264_put(struct t20_h264_bits *b, unsigned int n, u32 v)
+{
+	while (n--) {
+		if (v >> n & 1)
+			b->buf[b->pos >> 3] |= 0x80 >> (b->pos & 7);
+		b->pos++;
+	}
+}
+
+static void t20_h264_put_ue(struct t20_h264_bits *b, u32 v)
+{
+	t20_h264_put(b, 2 * fls(v + 1) - 1, v + 1);
+}
+
+static void t20_h264_put_se(struct t20_h264_bits *b, int v)
+{
+	t20_h264_put_ue(b, v > 0 ? 2 * v - 1 : -2 * v);
+}
+
+static void t20_h264_trailing(struct t20_h264_bits *b)
+{
+	t20_h264_put(b, 1, 1);
+	b->pos = ALIGN(b->pos, 8);
+}
+
+/* Copy with emulation prevention bytes; zeros: zero bytes just written */
+static u8 *t20_h264_escape(u8 *dst, u8 *end, const u8 *src, u32 len, unsigned int *zeros)
+{
+	while (len--) {
+		u8 c = *src++;
+
+		if (end - dst < 2)
+			return NULL;
+		if (*zeros >= 2 && c <= 3) {
+			*dst++ = 3;
+			*zeros = 0;
+		}
+		*dst++ = c;
+		*zeros = c ? 0 : *zeros + 1;
+	}
+	return dst;
+}
+
+/* A NAL unit of rbsp: start code, header, the escaped payload */
+static u8 *t20_h264_nal(u8 *dst, u8 *end, unsigned int ref_idc, unsigned int type,
+			const u8 *rbsp, u32 len, unsigned int *zeros)
+{
+	static const u8 start[4] = { 0, 0, 0, 1 };
+
+	if (end - dst < 5)
+		return NULL;
+	memcpy(dst, start, 4);
+	dst[4] = ref_idc << 5 | type;
+	*zeros = 0;
+	return t20_h264_escape(dst + 5, end, rbsp, len, zeros);
+}
+
+static u32 t20_h264_level(struct t20_h264_ctx *ctx)
+{
+	u32 mbs = ctx->mbw * ctx->mbh;
+
+	/* By frame size, for up to 30 frames per second */
+	if (mbs <= 396)
+		return 20;
+	if (mbs <= 1620)
+		return 30;
+	if (mbs <= 3600)
+		return 31;
+	if (mbs <= 5120)
+		return 32;
+	if (mbs <= 8192)
+		return 40;
+	return 50;
+}
+
+static u32 t20_h264_sps(struct t20_h264_ctx *ctx, u8 *buf)
+{
+	struct v4l2_pix_format *f = &ctx->out_fmt;
+	struct t20_h264_bits b = { buf };
+	u32 crop_r = (ctx->mbw * 16 - f->width) / 2;
+	u32 crop_b = (ctx->mbh * 16 - f->height) / 2;
+
+	t20_h264_put(&b, 8, 77);		/* Main profile */
+	t20_h264_put(&b, 8, 0x40);		/* constraint_set1: Main */
+	t20_h264_put(&b, 8, t20_h264_level(ctx));
+	t20_h264_put_ue(&b, 0);			/* seq_parameter_set_id */
+	t20_h264_put_ue(&b, T20_H264_LOG2_MAX_FRAME_NUM - 4);
+	t20_h264_put_ue(&b, 2);			/* pic_order_cnt_type: from frame_num */
+	t20_h264_put_ue(&b, 1);			/* max_num_ref_frames */
+	t20_h264_put(&b, 1, 0);			/* gaps_in_frame_num_value_allowed */
+	t20_h264_put_ue(&b, ctx->mbw - 1);
+	t20_h264_put_ue(&b, ctx->mbh - 1);
+	t20_h264_put(&b, 1, 1);			/* frame_mbs_only */
+	t20_h264_put(&b, 1, 1);			/* direct_8x8_inference */
+	t20_h264_put(&b, 1, crop_r || crop_b);	/* frame_cropping */
+	if (crop_r || crop_b) {
+		t20_h264_put_ue(&b, 0);
+		t20_h264_put_ue(&b, crop_r);
+		t20_h264_put_ue(&b, 0);
+		t20_h264_put_ue(&b, crop_b);
+	}
+	t20_h264_put(&b, 1, 1);			/* vui_parameters_present */
+	t20_h264_put(&b, 1, 0);			/* aspect_ratio_info_present */
+	t20_h264_put(&b, 1, 0);			/* overscan_info_present */
+	t20_h264_put(&b, 1, 1);			/* video_signal_type_present */
+	t20_h264_put(&b, 3, 5);			/* video_format: unspecified */
+	t20_h264_put(&b, 1, f->quantization == V4L2_QUANTIZATION_FULL_RANGE);
+	t20_h264_put(&b, 1, 1);			/* colour_description_present */
+	t20_h264_put(&b, 8, 1);			/* primaries: BT.709 (sRGB) */
+	t20_h264_put(&b, 8, 13);		/* transfer: sRGB */
+	t20_h264_put(&b, 8, 6);			/* matrix: BT.601 */
+	t20_h264_put(&b, 1, 0);			/* chroma_loc_info_present */
+	t20_h264_put(&b, 1, 0);			/* timing_info_present */
+	t20_h264_put(&b, 1, 0);			/* nal_hrd_parameters_present */
+	t20_h264_put(&b, 1, 0);			/* vcl_hrd_parameters_present */
+	t20_h264_put(&b, 1, 0);			/* pic_struct_present */
+	t20_h264_put(&b, 1, 1);			/* bitstream_restriction */
+	t20_h264_put(&b, 1, 1);			/* motion_vectors_over_pic_boundaries */
+	t20_h264_put_ue(&b, 0);			/* max_bytes_per_pic_denom */
+	t20_h264_put_ue(&b, 0);			/* max_bits_per_mb_denom */
+	t20_h264_put_ue(&b, 13);		/* log2_max_mv_length_horizontal */
+	t20_h264_put_ue(&b, 11);		/* log2_max_mv_length_vertical */
+	t20_h264_put_ue(&b, 0);			/* max_num_reorder_frames */
+	t20_h264_put_ue(&b, 1);			/* max_dec_frame_buffering */
+	t20_h264_trailing(&b);
+	return b.pos / 8;
+}
+
+static u32 t20_h264_pps(u8 *buf)
+{
+	struct t20_h264_bits b = { buf };
+
+	t20_h264_put_ue(&b, 0);			/* pic_parameter_set_id */
+	t20_h264_put_ue(&b, 0);			/* seq_parameter_set_id */
+	t20_h264_put(&b, 1, 1);			/* entropy_coding_mode: CABAC */
+	t20_h264_put(&b, 1, 0);			/* bottom_field_pic_order_in_frame_present */
+	t20_h264_put_ue(&b, 0);			/* num_slice_groups_minus1 */
+	t20_h264_put_ue(&b, 0);			/* num_ref_idx_l0_default_active_minus1 */
+	t20_h264_put_ue(&b, 0);			/* num_ref_idx_l1_default_active_minus1 */
+	t20_h264_put(&b, 1, 0);			/* weighted_pred */
+	t20_h264_put(&b, 2, 0);			/* weighted_bipred_idc */
+	t20_h264_put_se(&b, 0);			/* pic_init_qp_minus26 */
+	t20_h264_put_se(&b, 0);			/* pic_init_qs_minus26 */
+	t20_h264_put_se(&b, 0);			/* chroma_qp_index_offset */
+	t20_h264_put(&b, 1, 1);			/* deblocking_filter_control_present */
+	t20_h264_put(&b, 1, 0);			/* constrained_intra_pred */
+	t20_h264_put(&b, 1, 0);			/* redundant_pic_cnt_present */
+	t20_h264_trailing(&b);
+	return b.pos / 8;
+}
+
+/* Up to the CABAC slice data, which starts byte aligned */
+static u32 t20_h264_slice_header(struct t20_h264_ctx *ctx, u8 *buf)
+{
+	struct t20_h264_bits b = { buf };
+
+	t20_h264_put_ue(&b, 0);			/* first_mb_in_slice */
+	t20_h264_put_ue(&b, ctx->idr ? 7 : 5);	/* slice_type: all I or all P */
+	t20_h264_put_ue(&b, 0);			/* pic_parameter_set_id */
+	t20_h264_put(&b, T20_H264_LOG2_MAX_FRAME_NUM, ctx->frame_num);
+	if (ctx->idr)
+		t20_h264_put_ue(&b, ctx->idr_pic_id);
+	else {
+		t20_h264_put(&b, 1, 0);		/* num_ref_idx_active_override */
+		t20_h264_put(&b, 1, 0);		/* ref_pic_list_modification_flag_l0 */
+	}
+	if (ctx->idr) {
+		t20_h264_put(&b, 1, 0);		/* no_output_of_prior_pics */
+		t20_h264_put(&b, 1, 0);		/* long_term_reference */
+	} else {
+		t20_h264_put(&b, 1, 0);		/* adaptive_ref_pic_marking_mode */
+		t20_h264_put_ue(&b, 0);		/* cabac_init_idc */
+	}
+	t20_h264_put_se(&b, ctx->qp - 26);	/* slice_qp_delta */
+	t20_h264_put_ue(&b, 0);			/* disable_deblocking_filter_idc */
+	t20_h264_put_se(&b, 0);			/* slice_alpha_c0_offset_div2 */
+	t20_h264_put_se(&b, 0);			/* slice_beta_offset_div2 */
+	while (b.pos & 7)
+		t20_h264_put(&b, 1, 1);		/* cabac_alignment_one_bit */
+	return b.pos / 8;
+}
+
+/* The frame's NAL units up to the slice data, into ctx->hdr */
+static void t20_h264_write_header(struct t20_h264_ctx *ctx)
+{
+	u8 rbsp[64], *p = ctx->hdr, *end = ctx->hdr + sizeof(ctx->hdr);
+	u32 len;
+
+	if (ctx->idr) {
+		memset(rbsp, 0, sizeof(rbsp));
+		len = t20_h264_sps(ctx, rbsp);
+		p = t20_h264_nal(p, end, 3, 7, rbsp, len, &ctx->hdr_zeros);
+		memset(rbsp, 0, sizeof(rbsp));
+		len = t20_h264_pps(rbsp);
+		p = t20_h264_nal(p, end, 3, 8, rbsp, len, &ctx->hdr_zeros);
+	}
+	memset(rbsp, 0, sizeof(rbsp));
+	len = t20_h264_slice_header(ctx, rbsp);
+	p = t20_h264_nal(p, end, ctx->idr ? 3 : 2, ctx->idr ? 5 : 1, rbsp, len,
+			 &ctx->hdr_zeros);
+	ctx->hdr_len = p - ctx->hdr;
+}
+
+/* Job */
+
+/* CABAC context: the initial state (preCtxState, 1-126) */
+static u32 t20_h264_ctx_init(const s8 *mn, int qp)
+{
+	return clamp(((mn[0] * qp) >> 4) + mn[1], 1, 126);
+}
+
+/* For the SDE: pStateIdx's LPS ranges | valMPS */
+static u32 t20_h264_ctx_state(u32 s)
+{
+	return s <= 63 ? t20_h264_lps_range[63 - s] : t20_h264_lps_range[s - 64] | 1;
+}
+
+/*
+ * The contexts the VMAU's mode decision codes with: mb_type (I: 3-12, P:
+ * 14-23), coded_block_pattern (73-84), the intra prediction modes (64-69)
+ * and mvd (40-53)
+ */
+static unsigned int t20_h264_vmau_ctx(bool p, unsigned int i)
+{
+	if (i < 10)
+		return i + (p ? 14 : 3);
+	if (i < 22)
+		return i - 10 + 73;
+	if (i < 28)
+		return i - 22 + 64;
+	return i - 28 + 40;
+}
+
+static void t20_h264_build_desc(struct t20_vpu *t20vpu, struct t20_h264_ctx *ctx,
+				dma_addr_t src)
+{
+	struct v4l2_pix_format *f = &ctx->out_fmt;
+	u32 mbw = ctx->mbw, mbh = ctx->mbh, vpu = t20vpu->phys, p = !ctx->idr;
+	u32 luma = mbw * mbh * 256, one = luma * 3 / 2;
+	u32 rec = ctx->ref_dma + ctx->cur * one;
+	u32 ref = ctx->ref_dma + (ctx->cur ^ 1) * one;
+	const s8 (*cabac)[2] = t20_h264_cabac_init[p];
+	u32 *d = t20vpu->desc;
+	unsigned int i;
+
+	d = t20_vpu_acfg(d, VPU_TCSM_FLUSH, 0);
+
+	/* Front end: the NV12 frame; no regions of interest, no QP table */
+	d = t20_vpu_acfg(d, VPU_EFE_GEOM, (mbh - 1) << 8 | (mbw - 1));
+	d = t20_vpu_acfg(d, VPU_EFE_COEF_BA, vpu + VRAM_MAU_RESA);
+	d = t20_vpu_acfg(d, VPU_EFE_RAWY_SBA, src);
+	d = t20_vpu_acfg(d, VPU_EFE_RAWC_SBA, src + f->bytesperline * f->height);
+	d = t20_vpu_acfg(d, VPU_EFE_RAWV_SBA, 0);
+	d = t20_vpu_acfg(d, VPU_EFE_RAW_STRD, f->bytesperline << 16 | f->bytesperline);
+	d = t20_vpu_acfg(d, VPU_EFE_TOPMV_BA, vpu + VRAM_TOPMV);
+	d = t20_vpu_acfg(d, VPU_EFE_TOPPA_BA, vpu + VRAM_TOPPA);
+	d = t20_vpu_acfg(d, VPU_EFE_MECHN_BA, vpu + VRAM_ME_CHN);
+	d = t20_vpu_acfg(d, VPU_EFE_MAUCHN_BA, vpu + VRAM_MAU_CHN);
+	d = t20_vpu_acfg(d, VPU_EFE_DBLKCHN_BA, vpu + VRAM_DBLK_CHN);
+	d = t20_vpu_acfg(d, VPU_EFE_SDECHN_BA, vpu + VRAM_SDE_CHN);
+	d = t20_vpu_acfg(d, VPU_EFE_RAW_DBA, vpu + VRAM_RAWY);
+	d = t20_vpu_acfg(d, VPU_EFE_ROI_MAX_QP, 51);
+	for (i = 0; i < 2; i++)
+		d = t20_vpu_acfg(d, VPU_EFE_ROI_BASE(i), 0);
+	for (i = 0; i < 8; i++)
+		d = t20_vpu_acfg(d, VPU_EFE_ROI_POS(i), 0);
+	d = t20_vpu_acfg(d, VPU_EFE_QP_GEN_TAB, VRAM_QP_TAB);
+	d = t20_vpu_acfg(d, VPU_EFE_CQP_OFST, 0);
+	d = t20_vpu_acfg(d, VPU_EFE_SSAD, 0);
+	d = t20_vpu_acfg(d, VPU_EFE_DCS, EFE_DCS_T20);
+
+	/* Motion: search the reference, interpolate */
+	if (p) {
+		d = t20_vpu_acfg(d, VPU_MCE_CHN_BA, vpu + VRAM_ME_CHN);
+		d = t20_vpu_acfg(d, VPU_MCE_TMV_BA, vpu + VRAM_TOPMV);
+		d = t20_vpu_acfg(d, VPU_MCE_CHN_SYNC, vpu + VPU_SCH_SCHE(1));
+		d = t20_vpu_acfg(d, VPU_MCE_FRM_SIZE, (f->height - 1) << 16 | (f->width - 1));
+		d = t20_vpu_acfg(d, VPU_MCE_FRM_STRD, mbw * 16 << 16 | mbw * 16);
+		d = t20_vpu_acfg(d, VPU_MCE_COMP_CTRL, MCE_COMP_H264);
+		d = t20_vpu_acfg(d, VPU_MCE_ESTI_CTRL, MCE_ESTI_H264);
+		d = t20_vpu_acfg(d, VPU_MCE_MRGI, 0);
+		d = t20_vpu_acfg(d, VPU_MCE_MVR, MCE_MVR_500);
+		d = t20_vpu_acfg(d, VPU_MCE_RLUT, ref);
+		d = t20_vpu_acfg(d, VPU_MCE_RLUT + 4, ref + luma);
+		for (i = 0; i < 16; i++) {
+			bool two = t20_h264_luma_ilut[i][1];
+
+			d = t20_vpu_acfg(d, VPU_MCE_ILUT_Y + 8 * i, t20_h264_luma_ilut[i][0]);
+			d = t20_vpu_acfg(d, VPU_MCE_ILUT_Y + 8 * i + 4, t20_h264_luma_ilut[i][1]);
+			d = t20_vpu_acfg(d, VPU_MCE_CLUT_Y + 16 * i,
+					  i ? T20_H264_LUMA_TAPS_L : 1);
+			d = t20_vpu_acfg(d, VPU_MCE_CLUT_Y + 16 * i + 4,
+					  i ? T20_H264_LUMA_TAPS_M : 0);
+			d = t20_vpu_acfg(d, VPU_MCE_CLUT_Y + 16 * i + 8,
+					  two ? T20_H264_LUMA_TAPS_L : 0);
+			d = t20_vpu_acfg(d, VPU_MCE_CLUT_Y + 16 * i + 12,
+					  two ? T20_H264_LUMA_TAPS_M : 0);
+		}
+		for (i = 0; i < 16; i++) {
+			d = t20_vpu_acfg(d, VPU_MCE_ILUT_C + 8 * i, t20_h264_chroma_ilut[i][0]);
+			d = t20_vpu_acfg(d, VPU_MCE_ILUT_C + 8 * i + 4, t20_h264_chroma_ilut[i][1]);
+			d = t20_vpu_acfg(d, VPU_MCE_CLUT_C + 16 * i, i ? 0 : 1);
+			d = t20_vpu_acfg(d, VPU_MCE_CLUT_C + 16 * i + 8, 0);
+		}
+		d = t20_vpu_acfg(d, VPU_MCE_SLC_SPOS, 0);
+		d = t20_vpu_acfg(d, VPU_MCE_FSC, 0);
+		d = t20_vpu_acfg(d, VPU_MCE_GLB_CTRL, MCE_GLB_CTRL_RM | MCE_GLB_CTRL_INIT);
+	}
+
+	/* Transform, quantisation and mode decision */
+	d = t20_vpu_acfg(d, VPU_VMAU_GBL_RUN, VMAU_RESET);
+	d = t20_vpu_acfg(d, VPU_VMAU_VIDEO_TYPE, VMAU_H264E);
+	d = t20_vpu_acfg(d, VPU_VMAU_NCCHN_ADDR, vpu + VRAM_MAU_CHN);
+	d = t20_vpu_acfg(d, VPU_VMAU_ENC_DONE, vpu + VRAM_DUMMY);
+	d = t20_vpu_acfg(d, VPU_VMAU_DEC_DONE, vpu + VPU_SCH_SCHE(2));
+	d = t20_vpu_acfg(d, VPU_VMAU_Y_GS, mbh * 16 << 16 | mbw * 16);
+	d = t20_vpu_acfg(d, VPU_VMAU_GBL_CTR, VMAU_CTRL_TO_DBLK | VMAU_CTRL_FIFO_M);
+	d = t20_vpu_acfg(d, VPU_VMAU_DEADZONE, VMAU_DEADZONE);
+	d = t20_vpu_acfg(d, VPU_VMAU_TOP_BASE, vpu + VRAM_TOPPA);
+	d = t20_vpu_acfg(d, VPU_VMAU_MD_CFG0, (mbh - 1) << 24 | (mbw - 1) << 16 | (p ? 2 : 1));
+	d = t20_vpu_acfg(d, VPU_VMAU_MD_CFG1, VMAU_MD_CFG1_T20);
+	d = t20_vpu_acfg(d, VPU_VMAU_MD_CFG2, VMAU_MD_CFG2_T20);
+	d = t20_vpu_acfg(d, VPU_VMAU_MD_CFG3, 0);
+	d = t20_vpu_acfg(d, VPU_VMAU_MD_CFG4, 0);
+	d = t20_vpu_acfg(d, VPU_VMAU_MD_CFG5, 0);
+	for (i = 0; i < 42; i++)
+		d = t20_vpu_acfg(d, VPU_VMAU_CTX,
+				  t20_h264_ctx_init(cabac[t20_h264_vmau_ctx(p, i)], ctx->qp));
+	d = t20_vpu_acfg(d, VPU_VMAU_ACMASK, 2);
+	d = t20_vpu_acfg(d, VPU_VMAU_GBL_RUN, VMAU_RUN);
+
+	/* Deblocking into the reconstructed frame */
+	d = t20_vpu_acfg(d, VPU_DBLK_TRIG, DBLK_RESET);
+	d = t20_vpu_acfg(d, VPU_DBLK_DHA, vpu + VRAM_DBLK_CHN);
+	d = t20_vpu_acfg(d, VPU_DBLK_GENDA, vpu + VPU_SCH_SCHE(3));
+	d = t20_vpu_acfg(d, VPU_DBLK_GSIZE, mbh << 16 | mbw);
+	d = t20_vpu_acfg(d, VPU_DBLK_GPOS, 0);
+	d = t20_vpu_acfg(d, VPU_DBLK_CTRL, DBLK_FILTER);
+	d = t20_vpu_acfg(d, VPU_DBLK_GPIC_YA, rec);
+	d = t20_vpu_acfg(d, VPU_DBLK_GPIC_CA, rec + luma);
+	d = t20_vpu_acfg(d, VPU_DBLK_GP_ENDA, vpu + VRAM_DUMMY);
+	d = t20_vpu_acfg(d, VPU_DBLK_GPIC_STR, mbw * 128 << 16 | mbw * 256);
+	d = t20_vpu_acfg(d, VPU_DBLK_VTR, (p ? DBLK_VTR_P : 0) | DBLK_VTR_H264);
+	d = t20_vpu_acfg(d, VPU_DBLK_TRIG, DBLK_SLICE_RUN);
+
+	/* Stream encoder: slice data after our slice header */
+	d = t20_vpu_acfg(d, VPU_SDE_STAT, 0);
+	d = t20_vpu_acfg(d, VPU_SDE_GL_CTRL, SDE_MODE_STEP | SDE_EN);
+	d = t20_vpu_acfg(d, VPU_SDE_SL_GEOM, mbh << 24 | mbw << 16);
+	d = t20_vpu_acfg(d, VPU_SDE_CODEC_ID, SDE_H264_ENC);
+	d = t20_vpu_acfg(d, VPU_SDE_CFG(0), 0x3);	/* descriptor link, auto sync */
+	d = t20_vpu_acfg(d, VPU_SDE_CFG(1), ctx->qp << 8 | SDE_CFG1_T20 | (p + 1));
+	d = t20_vpu_acfg(d, VPU_SDE_CFG(2), vpu + VRAM_SDE_CHN);
+	d = t20_vpu_acfg(d, VPU_SDE_CFG(3), vpu + VPU_SCH_SCHE(4));
+	d = t20_vpu_acfg(d, VPU_SDE_CFG(4), ctx->bs_dma);
+	for (i = 0; i < 460; i++)
+		d = t20_vpu_acfg(d, VPU_SDE_CTX_TBL + 4 * i,
+				  t20_h264_ctx_state(t20_h264_ctx_init(cabac[i], ctx->qp)));
+	d = t20_vpu_acfg(d, VPU_SDE_SL_CTRL, SDE_SLICE_INIT);
+
+	/* Scheduler: MCE (P frames only), VMAU, DBLK, SDE */
+	d = t20_vpu_acfg(d, VPU_SCH_SCHC, 0);
+	d = t20_vpu_acfg(d, VPU_SCH_BND, 0);
+	d = t20_vpu_acfg(d, VPU_SCH_SCHG0, 0);
+	d = t20_vpu_acfg(d, VPU_SCH_SCHG1, 0);
+	for (i = 1; i <= 4; i++)
+		d = t20_vpu_acfg(d, VPU_SCH_SCHE(i), 0);
+	d = t20_vpu_acfg(d, VPU_SCH_SCHC, SCH_SCHC_H264E | (p ? SCH_SCHC_P : 0));
+	d = t20_vpu_acfg(d, VPU_SCH_BND, SCH_BND_H264E | (p ? SCH_BND_P : 0));
+
+	d = t20_vpu_acfg(d, VPU_EFE_CTRL, EFE_TSE | EFE_FMVP | EFE_X264_QP(ctx->qp) |
+			  EFE_DBLK_EN | (p ? EFE_SLICE_P : 0) | EFE_PLANE_NV12 |
+			  EFE_EN | EFE_RUN);
+	t20_vpu_acfg_end(t20vpu, d);
+}
+
+/* The frame's NAL units into the capture buffer: header, then slice data */
+static int t20_h264_output(struct t20_h264_ctx *ctx, struct vb2_v4l2_buffer *dst,
+			   u32 bs_len)
+{
+	u8 *start = vb2_plane_vaddr(&dst->vb2_buf, 0);
+	u8 *end = start + vb2_plane_size(&dst->vb2_buf, 0), *p;
+	unsigned int zeros = ctx->hdr_zeros;
+
+	if (bs_len > ctx->bs_size || ctx->hdr_len > end - start)
+		return -ENOSPC;
+	memcpy(start, ctx->hdr, ctx->hdr_len);
+	p = t20_h264_escape(start + ctx->hdr_len, end, ctx->bs, bs_len, &zeros);
+	if (!p)
+		return -ENOSPC;
+	vb2_set_plane_payload(&dst->vb2_buf, 0, p - start);
+	return 0;
+}
+
+/* log2(x) in 1/256 */
+static int t20_h264_log2(u32 x)
+{
+	int n = fls(x) - 1;
+
+	return n * 256 + (n >= 8 ? x >> (n - 8) : x << (8 - n)) % 256;
+}
+
+/*
+ * Frame-level rate control: the bits of a frame halve every 6 QP. The next
+ * frames aim at the budget less 1/8 of the debt (an I frame's excess is paid
+ * back over the following P frames); the P frame QP follows that, at most 3
+ * a frame.
+ */
+static void t20_h264_rc_update(struct t20_h264_ctx *ctx, u32 bits)
+{
+	struct v4l2_fract *t = &ctx->timeperframe;
+	s64 budget = div_u64((u64)ctx->bitrate * t->numerator, t->denominator);
+	s64 target;
+	int delta;
+
+	ctx->rc_debt = clamp_t(s64, ctx->rc_debt + bits - budget,
+			       -(s64)ctx->bitrate, ctx->bitrate);
+	if (ctx->idr)
+		return;
+	target = clamp_t(s64, budget - div_s64(ctx->rc_debt, 8), budget / 4, budget * 2);
+	delta = 6 * (t20_h264_log2(bits) - t20_h264_log2(target));
+	delta = clamp(DIV_ROUND_CLOSEST(delta, 256), -3, 3);
+	ctx->rc_qp = clamp_t(int, ctx->rc_qp + delta, ctx->min_qp, ctx->max_qp);
+}
+
+/* The first QP: about 0.1 bit a pixel at QP 30 (P frames of a lit room) */
+static u32 t20_h264_rc_start_qp(struct t20_h264_ctx *ctx)
+{
+	struct v4l2_fract *t = &ctx->timeperframe;
+	u32 budget = div_u64((u64)ctx->bitrate * t->numerator, t->denominator);
+	u32 bits_qp30 = ctx->out_fmt.width * ctx->out_fmt.height / 10;
+	int qp = 30 + DIV_ROUND_CLOSEST(6 * (t20_h264_log2(bits_qp30) -
+					     t20_h264_log2(max(budget, 1U))), 256);
+
+	return clamp_t(int, qp, ctx->min_qp, ctx->max_qp);
+}
+
+static void t20_h264_done(struct t20_vpu_ctx *vctx, u32 stat)
+{
+	struct t20_h264_ctx *ctx = to_h264_ctx(vctx);
+	struct t20_vpu *vpu = vctx->vpu;
+	enum vb2_buffer_state state = VB2_BUF_STATE_ERROR;
+	struct vb2_v4l2_buffer *src, *dst;
+	u32 bs_len = 0;
+
+	if (stat & SCH_STAT_ENDF) {
+		bs_len = readl(vpu->regs + VPU_SDE_CFG(9)) & SDE_BS_LEN;
+		state = VB2_BUF_STATE_DONE;
+	} else if (stat) {
+		dev_err(vpu->dev, "H.264: encode failed: status %#x\n", stat);
+	}
+
+	src = v4l2_m2m_src_buf_remove(vctx->fh.m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(vctx->fh.m2m_ctx);
+	if (dst && state == VB2_BUF_STATE_DONE && t20_h264_output(ctx, dst, bs_len)) {
+		dev_err(vpu->dev, "H.264: frame too large (%u bytes)\n", bs_len);
+		state = VB2_BUF_STATE_ERROR;
+	}
+	if (state == VB2_BUF_STATE_DONE) {
+		if (ctx->rc)
+			t20_h264_rc_update(ctx, vb2_get_plane_payload(&dst->vb2_buf, 0) * 8);
+		/* This frame is the next one's reference */
+		ctx->cur ^= 1;
+		ctx->frame_num = (ctx->frame_num + 1) % BIT(T20_H264_LOG2_MAX_FRAME_NUM);
+		if (++ctx->gop_pos >= ctx->gop_size)
+			ctx->gop_pos = 0;
+	} else {
+		ctx->gop_pos = 0;	/* start again with an IDR frame */
+	}
+	if (src && dst) {
+		v4l2_m2m_buf_copy_metadata(src, dst, true);
+		dst->flags &= ~(V4L2_BUF_FLAG_KEYFRAME | V4L2_BUF_FLAG_PFRAME);
+		dst->flags |= ctx->idr ? V4L2_BUF_FLAG_KEYFRAME : V4L2_BUF_FLAG_PFRAME;
+	}
+	if (src)
+		v4l2_m2m_buf_done(src, state);
+	if (dst)
+		v4l2_m2m_buf_done(dst, state);
+}
+
+static void t20_h264_run(struct t20_vpu_ctx *vctx)
+{
+	struct t20_h264_ctx *ctx = to_h264_ctx(vctx);
+	struct t20_vpu *vpu = vctx->vpu;
+	struct vb2_v4l2_buffer *src = v4l2_m2m_next_src_buf(vctx->fh.m2m_ctx);
+
+	ctx->idr = ctx->gop_pos == 0 || ctx->force_key;
+	if (ctx->idr) {
+		/* Consecutive IDR frames differ in idr_pic_id */
+		ctx->idr_pic_id = (ctx->idr_pic_id + 1) & 0xffff;
+		ctx->force_key = false;
+		ctx->gop_pos = 0;
+		ctx->frame_num = 0;
+	}
+	if (!ctx->rc)
+		ctx->qp = ctx->idr ? ctx->i_qp : ctx->p_qp;
+	else	/* I frames a little better: the P frames predict from them */
+		ctx->qp = clamp(ctx->rc_qp - (ctx->idr ? 2 : 0), ctx->min_qp, ctx->max_qp);
+	t20_h264_write_header(ctx);
+	dma_sync_single_for_device(vpu->dev, ctx->bs_dma, ctx->bs_size, DMA_FROM_DEVICE);
+	t20_h264_build_desc(vpu, ctx, vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0));
+}
+
+static const struct t20_vpu_codec t20_h264_codec = {
+	.run = t20_h264_run,
+	.done = t20_h264_done,
+};
+
+/* Formats */
+
+static void t20_h264_fill_fmt(struct t20_h264_ctx *ctx, u32 width, u32 height)
+{
+	struct v4l2_pix_format *out = &ctx->out_fmt, *cap = &ctx->cap_fmt;
+
+	/* The EFE reads whole macroblocks: whole ones across, rows past the end */
+	out->width = clamp_t(u32, ALIGN(width, 16), T20_H264_MIN_SIZE, T20_H264_MAX_SIZE);
+	out->height = clamp_t(u32, ALIGN(height, 2), T20_H264_MIN_SIZE, T20_H264_MAX_SIZE);
+	out->pixelformat = V4L2_PIX_FMT_NV12;
+	out->field = V4L2_FIELD_NONE;
+	out->bytesperline = out->width;
+	out->sizeimage = out->bytesperline * ALIGN(out->height, 16) * 3 / 2;
+	/* As the ISP writes by default; the range goes into the VUI */
+	out->colorspace = V4L2_COLORSPACE_SRGB;
+	out->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	if (out->quantization != V4L2_QUANTIZATION_LIM_RANGE)
+		out->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	out->xfer_func = V4L2_XFER_FUNC_SRGB;
+	ctx->mbw = out->width / 16;
+	ctx->mbh = DIV_ROUND_UP(out->height, 16);
+
+	*cap = *out;
+	cap->pixelformat = V4L2_PIX_FMT_H264;
+	cap->bytesperline = 0;
+	cap->sizeimage = out->width * out->height / 2 + T20_H264_HDR_SIZE;
+}
+
+static int t20_h264_querycap(struct file *file, void *fh, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, "t20-h264", sizeof(cap->driver));
+	strscpy(cap->card, "Ingenic T20 H.264 encoder", sizeof(cap->card));
+	return 0;
+}
+
+static int t20_h264_enum_fmt_out(struct file *file, void *fh, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_NV12;
+	return 0;
+}
+
+static int t20_h264_enum_fmt_cap(struct file *file, void *fh, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_H264;
+	f->flags = V4L2_FMT_FLAG_COMPRESSED;
+	return 0;
+}
+
+static int t20_h264_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct t20_h264_ctx *ctx = file_to_ctx(file);
+
+	f->fmt.pix = V4L2_TYPE_IS_OUTPUT(f->type) ? ctx->out_fmt : ctx->cap_fmt;
+	return 0;
+}
+
+/* The size comes from the output (raw) side; the capture side follows it */
+static int t20_h264_try_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct t20_h264_ctx *ctx = file_to_ctx(file), tmp;
+
+	tmp.out_fmt = ctx->out_fmt;
+	tmp.cap_fmt = ctx->cap_fmt;
+	if (V4L2_TYPE_IS_OUTPUT(f->type)) {
+		tmp.out_fmt.quantization = f->fmt.pix.quantization;
+		t20_h264_fill_fmt(&tmp, f->fmt.pix.width, f->fmt.pix.height);
+	}
+	f->fmt.pix = V4L2_TYPE_IS_OUTPUT(f->type) ? tmp.out_fmt : tmp.cap_fmt;
+	return 0;
+}
+
+static int t20_h264_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct t20_h264_ctx *ctx = file_to_ctx(file);
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->vpu_ctx.fh.m2m_ctx;
+
+	if (vb2_is_busy(v4l2_m2m_get_vq(m2m_ctx, f->type)))
+		return -EBUSY;
+	if (V4L2_TYPE_IS_OUTPUT(f->type)) {
+		if (vb2_is_busy(v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE)))
+			return -EBUSY;
+		ctx->out_fmt.quantization = f->fmt.pix.quantization;
+		t20_h264_fill_fmt(ctx, f->fmt.pix.width, f->fmt.pix.height);
+	}
+	return t20_h264_g_fmt(file, fh, f);
+}
+
+/* The frame rate, for the rate control */
+static int t20_h264_g_parm(struct file *file, void *fh, struct v4l2_streamparm *a)
+{
+	struct t20_h264_ctx *ctx = file_to_ctx(file);
+
+	if (!V4L2_TYPE_IS_OUTPUT(a->type))
+		return -EINVAL;
+	a->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
+	a->parm.output.timeperframe = ctx->timeperframe;
+	return 0;
+}
+
+static int t20_h264_s_parm(struct file *file, void *fh, struct v4l2_streamparm *a)
+{
+	struct t20_h264_ctx *ctx = file_to_ctx(file);
+	struct v4l2_fract *t = &a->parm.output.timeperframe;
+
+	if (!V4L2_TYPE_IS_OUTPUT(a->type))
+		return -EINVAL;
+	if (t->numerator && t->denominator)
+		ctx->timeperframe = *t;
+	return t20_h264_g_parm(file, fh, a);
+}
+
+const struct v4l2_ioctl_ops t20_vpu_h264_ioctl_ops = {
+	.vidioc_querycap = t20_h264_querycap,
+	.vidioc_enum_fmt_vid_out = t20_h264_enum_fmt_out,
+	.vidioc_enum_fmt_vid_cap = t20_h264_enum_fmt_cap,
+	.vidioc_g_fmt_vid_out = t20_h264_g_fmt,
+	.vidioc_g_fmt_vid_cap = t20_h264_g_fmt,
+	.vidioc_try_fmt_vid_out = t20_h264_try_fmt,
+	.vidioc_try_fmt_vid_cap = t20_h264_try_fmt,
+	.vidioc_s_fmt_vid_out = t20_h264_s_fmt,
+	.vidioc_s_fmt_vid_cap = t20_h264_s_fmt,
+	.vidioc_g_parm = t20_h264_g_parm,
+	.vidioc_s_parm = t20_h264_s_parm,
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+	.vidioc_subscribe_event = v4l2_ctrl_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* Queues */
+
+static int t20_h264_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+				unsigned int *nplanes, unsigned int sizes[],
+				struct device *alloc_devs[])
+{
+	struct t20_h264_ctx *ctx = vb2_get_drv_priv(q);
+
+	return t20_vpu_queue_setup(q, V4L2_TYPE_IS_OUTPUT(q->type) ? ctx->out_fmt.sizeimage :
+								    ctx->cap_fmt.sizeimage,
+				   nbuffers, nplanes, sizes);
+}
+
+static int t20_h264_buf_prepare(struct vb2_buffer *vb)
+{
+	struct t20_h264_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct v4l2_pix_format *f = &ctx->out_fmt;
+
+	/* NV12 with the chroma right after the luma, as the ISP writes it */
+	if (V4L2_TYPE_IS_OUTPUT(vb->type))
+		return vb2_plane_size(vb, 0) < f->bytesperline * f->height * 3 / 2 ?
+		       -EINVAL : 0;
+	return vb2_plane_size(vb, 0) < ctx->cap_fmt.sizeimage ? -EINVAL : 0;
+}
+
+static void t20_h264_free_bufs(struct t20_h264_ctx *ctx)
+{
+	struct device *dev = ctx->vpu_ctx.vpu->dev;
+
+	if (ctx->ref)
+		dma_free_coherent(dev, ctx->ref_size, ctx->ref, ctx->ref_dma);
+	if (ctx->bs_alloc)
+		dma_free_coherent(dev, ctx->bs_size, ctx->bs_alloc, ctx->bs_dma);
+	ctx->ref = NULL;
+	ctx->bs_alloc = NULL;
+}
+
+/* The reference frames and the slice data buffer, with the capture queue */
+static int t20_h264_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct t20_h264_ctx *ctx = vb2_get_drv_priv(q);
+	struct device *dev = ctx->vpu_ctx.vpu->dev;
+
+	if (V4L2_TYPE_IS_OUTPUT(q->type))
+		return 0;
+	ctx->ref_size = 2 * REF_SIZE(ctx->mbw, ctx->mbh);
+	ctx->ref = dma_alloc_coherent(dev, ctx->ref_size, &ctx->ref_dma, GFP_KERNEL);
+	/* As large as the raw frame: no QP makes more (I_PCM would not) */
+	ctx->bs_size = ctx->mbw * ctx->mbh * 384;
+	ctx->bs_alloc = dma_alloc_coherent(dev, ctx->bs_size, &ctx->bs_dma, GFP_KERNEL);
+	if (!ctx->ref || !ctx->bs_alloc) {
+		t20_h264_free_bufs(ctx);
+		t20_vpu_return_bufs(&ctx->vpu_ctx, q, VB2_BUF_STATE_QUEUED);
+		return -ENOMEM;
+	}
+	/*
+	 * Read through the cached mapping (KSEG0): reading the slice data
+	 * uncached runs at 4 MB/s. Invalidated before each job (no
+	 * speculative loads on the XBurst core).
+	 */
+	ctx->bs = phys_to_virt(ctx->bs_dma);
+	ctx->cur = 0;
+	ctx->gop_pos = 0;
+	ctx->frame_num = 0;
+	ctx->rc_qp = t20_h264_rc_start_qp(ctx);
+	ctx->rc_debt = 0;
+	return 0;
+}
+
+static void t20_h264_stop_streaming(struct vb2_queue *q)
+{
+	struct t20_h264_ctx *ctx = vb2_get_drv_priv(q);
+
+	t20_vpu_return_bufs(&ctx->vpu_ctx, q, VB2_BUF_STATE_ERROR);
+	if (!V4L2_TYPE_IS_OUTPUT(q->type))
+		t20_h264_free_bufs(ctx);
+}
+
+static const struct vb2_ops t20_h264_vb2_ops = {
+	.queue_setup = t20_h264_queue_setup,
+	.buf_prepare = t20_h264_buf_prepare,
+	.buf_queue = t20_vpu_buf_queue,
+	.start_streaming = t20_h264_start_streaming,
+	.stop_streaming = t20_h264_stop_streaming,
+};
+
+/* The CPU writes the capture buffers (the VPU the slice data elsewhere): cached */
+static int t20_h264_queue_init(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	return t20_vpu_queue_init(priv, src, dst, &t20_h264_vb2_ops, &vb2_vmalloc_memops);
+}
+
+/* Controls */
+static int t20_h264_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct t20_h264_ctx *ctx = container_of(ctrl->handler, struct t20_h264_ctx, ctrls);
+
+	switch (ctrl->id) {
+	case V4L2_CID_MPEG_VIDEO_GOP_SIZE:
+		ctx->gop_size = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_I_FRAME_QP:
+		ctx->i_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_P_FRAME_QP:
+		ctx->p_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
+		ctx->force_key = true;
+		break;
+	case V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE:
+		ctx->rc = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_BITRATE:
+		ctx->bitrate = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_MIN_QP:
+		ctx->min_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_MAX_QP:
+		ctx->max_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+	case V4L2_CID_MPEG_VIDEO_HEADER_MODE:
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops t20_h264_ctrl_ops = {
+	.s_ctrl = t20_h264_s_ctrl,
+};
+
+/* File operations */
+
+static int t20_h264_open(struct file *file)
+{
+	struct t20_vpu *vpu = video_drvdata(file);
+	struct v4l2_ctrl_handler *hdl;
+	struct t20_h264_ctx *ctx;
+	struct v4l2_fh *fh;
+	int ret;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	t20_vpu_ctx_init(&ctx->vpu_ctx, vpu, &vpu->h264_vdev, &t20_h264_codec);
+	fh = &ctx->vpu_ctx.fh;
+	ctx->out_fmt.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	t20_h264_fill_fmt(ctx, 1920, 1080);
+	ctx->timeperframe = (struct v4l2_fract){ 1, 25 };
+
+	hdl = &ctx->ctrls;
+	v4l2_ctrl_handler_init(hdl, 10);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_GOP_SIZE,
+			  1, 1000, 1, 50);
+	/* Below 10 the frames could overrun the buffers */
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_H264_I_FRAME_QP,
+			  10, 51, 1, 28);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_H264_P_FRAME_QP,
+			  10, 51, 1, 30);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME,
+			  0, 0, 0, 0);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE,
+			  0, 1, 1, 1);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_BITRATE,
+			  64000, 40000000, 1000, 4000000);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_H264_MIN_QP,
+			  10, 51, 1, 18);
+	v4l2_ctrl_new_std(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_H264_MAX_QP,
+			  10, 51, 1, 45);
+	v4l2_ctrl_new_std_menu(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+			       V4L2_MPEG_VIDEO_H264_PROFILE_MAIN,
+			       ~BIT(V4L2_MPEG_VIDEO_H264_PROFILE_MAIN),
+			       V4L2_MPEG_VIDEO_H264_PROFILE_MAIN);
+	v4l2_ctrl_new_std_menu(hdl, &t20_h264_ctrl_ops, V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+			       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME,
+			       ~BIT(V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME),
+			       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME);
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_ctrls;
+	}
+	v4l2_ctrl_handler_setup(hdl);
+	ctx->force_key = false;
+	fh->ctrl_handler = hdl;
+
+	fh->m2m_ctx = v4l2_m2m_ctx_init(vpu->m2m_dev, ctx, t20_h264_queue_init);
+	if (IS_ERR(fh->m2m_ctx)) {
+		ret = PTR_ERR(fh->m2m_ctx);
+		goto err_ctrls;
+	}
+	v4l2_fh_add(fh, file);
+	return 0;
+
+err_ctrls:
+	v4l2_ctrl_handler_free(hdl);
+	v4l2_fh_exit(fh);
+	kfree(ctx);
+	return ret;
+}
+
+const struct v4l2_file_operations t20_vpu_h264_fops = {
+	.owner = THIS_MODULE,
+	.open = t20_h264_open,
+	.release = t20_vpu_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
