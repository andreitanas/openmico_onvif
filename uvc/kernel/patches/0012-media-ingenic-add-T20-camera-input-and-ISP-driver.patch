+static int t20_isp_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *f)
+{
+	if (f->index || (f->mbus_code && f->mbus_code != MEDIA_BUS_FMT_YUV10_1X30))
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_NV12;
+	return 0;
+}
+
+static int t20_isp_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct t20_isp_path *path = video_drvdata(file);
+
+	f->fmt.pix = path->pix;
+	return 0;
+}
+
+/*
+ * The main path is the sensor's size (its scaler is bypassed); the second
+ * path scales down to any even size
+ */
+static int t20_isp_try_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct t20_isp_path *path = video_drvdata(file);
+	struct t20_isp *isp = path->isp;
+	u32 w = isp->width, h = isp->height;
+
+	if (path != &isp->paths[T20_ISP_MAIN]) {
+		w = clamp_t(u32, f->fmt.pix.width, T20_ISP_MIN_SIZE, w) & ~1;
+		h = clamp_t(u32, f->fmt.pix.height, T20_ISP_MIN_SIZE, h) & ~1;
+	}
+	t20_isp_fill_pix(&f->fmt.pix, w, h, f->fmt.pix.quantization);
+	return 0;
+}
+
+static int t20_isp_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct t20_isp_path *path = video_drvdata(file);
+	int ret;
+
+	if (vb2_is_busy(&path->queue))
+		return -EBUSY;
+	ret = t20_isp_try_fmt(file, fh, f);
+	if (!ret)
+		path->pix = f->fmt.pix;
+	return ret;
+}
