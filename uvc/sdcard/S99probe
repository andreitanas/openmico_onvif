#!/bin/sh
#
# Write a hardware/system report to the sdcard on every boot, so the camera
# can be diagnosed by reading the card even when it is not reachable.
#

OUT=/sdcard/probe.txt

probe() {
	echo "== date"; date
	echo "== uname"; uname -a
	echo "== cmdline"; cat /proc/cmdline
	echo "== cpuinfo"; cat /proc/cpuinfo
	echo "== meminfo"; cat /proc/meminfo
	echo "== df"; df -h
	echo "== mounts"; cat /proc/mounts
	echo "== network"; ifconfig; iwconfig 2>/dev/null; cat /etc/resolv.conf; route -n
	echo "== processes"; ps
	echo "== video devices"; ls -l /dev/video* /dev/dsp* 2>&1
	echo "== modules"; lsmod
	echo "== libraries"; ls -l /usr/lib /lib 2>/dev/null | grep -i -E "imp|alog|sysutils"
	echo "== IVS symbols in libimp"
	for f in /usr/lib/libimp.so /lib/libimp.so; do
		[ -f $f ] && grep -o -a -E "IMP_IVS_[A-Za-z]+|IMP_FrameSource_[A-Za-z]+" $f | sort -u
	done
	echo "== tools"; for t in micropython ffmpeg python3 strings openssl curl nc; do printf "%s: " $t; which $t || echo missing; done
	echo "== uvcd runs?"; /sdcard/uvc/uvcd -h; echo "exit=$? (2 = usage, binary runs)"
	echo "== uvcd log tail"; tail -50 /sdcard/var/log/uvcd.log 2>/dev/null
	echo "== dmesg tail"; dmesg | tail -150
}

case "$1" in
  start)
	# Late in boot, after the camera stack had a moment to settle.
	( sleep 60; probe > $OUT 2>&1; sync ) > /dev/null 2>&1 &
	;;
  stop|restart|reload)
	;;
esac

exit 0
