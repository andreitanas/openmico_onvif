#!/bin/sh
# WiFi (Realtek 8189FS on SDIO) and DHCP. udhcpc keeps retrying in the
# background until it gets a lease.
case "$1" in
start)
	insmod /lib/modules/3.10.14/kernel/drivers/net/wireless/rtl818x/rtl8189FS/8189fs.ko
	# Files edited on Windows
	sed -i 's/\r$//' /etc/wpa_supplicant.conf
	wpa_supplicant -B -Dnl80211 -i wlan0 -c /etc/wpa_supplicant.conf
	udhcpc -i wlan0 -b -S -t 6 -A 10 -x hostname:"$(hostname)"
	;;
stop)
	killall udhcpc wpa_supplicant 2>/dev/null
	;;
esac
