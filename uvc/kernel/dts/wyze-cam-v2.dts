// SPDX-License-Identifier: GPL-2.0
/*
 * Wyze Cam v2: Ingenic T20 ("bull" board in Ingenic's 3.10.14 tree), 128 MB
 * DDR, 16 MB SPI NOR on the SFC, SD card on MSC0, RTL8189FS WiFi on MSC1.
 * Board GPIOs from the vendor bull/board.h and OpenMiko's kernel patches
 * (patches/kernel/linux-led.patch).
 */
/dts-v1/;

#include "t20.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "wyze,cam-v2", "ingenic,t20";
	model = "Wyze Cam v2";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};

	/*
	 * U-Boot's own arguments (mem=, ispmem=, rmem=, mtdparts=) are
	 * ignored: the kernel takes these (CONFIG_MIPS_CMDLINE_FROM_DTB).
	 */
	chosen {
		stdout-path = "serial1:115200n8";
		bootargs = "console=ttyS1,115200n8 earlycon root=/dev/mtdblock2 rootfstype=squashfs ro panic=10";
	};

	/*
	 * Linux gets the low 96 MB as today (mem=96M@0x0). 0x6000000-0x8000000
	 * stays outside it for the ISP (8 MB, "ispmem") and the encoder's
	 * reserved memory (24 MB, "rmem"), which libimp maps through /dev/mem.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x6000000>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "led_blue";
			gpios = <&gpb 7 GPIO_ACTIVE_LOW>;	/* GPIO 39 */
			default-state = "off";
		};

		led-1 {
			label = "led_yellow";
			gpios = <&gpb 6 GPIO_ACTIVE_LOW>;	/* GPIO 38 */
			default-state = "on";
		};
	};

	/* RTL8189FS power: WL_REG_EN, PC16 (GPIO 80), high = on */
	wlan_pwrseq: wlan-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpc 16 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;

	status = "okay";
};

&sfc {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_sfc>;

	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;

		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;

		/* Same layout as the stock firmware and OpenMiko */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "kernel";
				reg = <0x40000 0x200000>;
			};

			partition@240000 {
				label = "root";
				reg = <0x240000 0xd30000>;
			};

			partition@f70000 {
				label = "config";
				reg = <0xf70000 0x40000>;
			};

			partition@fb0000 {
				label = "para";
				reg = <0xfb0000 0x40000>;
			};

			partition@ff0000 {
				label = "flag";
				reg = <0xff0000 0x10000>;
			};
		};
	};
};

/* SD card: 4 bit on PB0-PB5. Polled: card detect is not confirmed. */
&msc0 {
	bus-width = <4>;
	max-frequency = <48000000>;
	cap-sd-highspeed;
	broken-cd;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_msc0>;

	status = "okay";
};

/* RTL8189FS WiFi: SDIO, 4 bit on PC2-PC7 */
&msc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	bus-width = <4>;
	max-frequency = <24000000>;
	non-removable;
	cap-sdio-irq;
	keep-power-in-suspend;

	mmc-pwrseq = <&wlan_pwrseq>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_msc1>;

	status = "okay";

	wifi@1 {
		reg = <1>;
	};
};

/* Image sensor (JXF22/JXF23); used once the ISP driver is ported */
&i2c0 {
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;

	status = "okay";
};

&pinctrl {
	pins_uart1: uart1 {
		function = "uart1";
		groups = "uart1-data";
	};

	pins_sfc: sfc {
		function = "sfc";
		groups = "sfc";
	};

	pins_msc0: msc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit";
	};

	pins_msc1: msc1 {
		function = "mmc1";
		groups = "mmc1-1bit", "mmc1-4bit";
	};

	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data";
	};
};
