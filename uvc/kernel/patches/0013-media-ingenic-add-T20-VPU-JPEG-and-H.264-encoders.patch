From: openmico_onvif <andrei.tanas@gmail.com>
Subject: [PATCH] media: ingenic: add T20 VPU JPEG and H.264 encoders

V4L2 mem2mem encoders on the T20's VPU, one driver with a video node for
each, sharing one job queue (the VPU runs one job at a time). Both take
NV12 (the ISP's frames, also as dma-bufs).

JPEG: baseline JFIF 4:2:0, quality 1-100. The VPU sequence and the Huffman
encoder table are from Ingenic's GPL-2.0 drivers for the same blocks (X1000
JPEG, T31 helix); headers and quantisation tables are generated here.

H.264: Main profile, CABAC, I and P frames, one slice a frame, constant QP
or a frame-level rate control. The T20's encoder is Ingenic's "Helix": the
register names and fields are those of Ingenic's GPL-2.0 Helix encoder (T31
SDK), the motion filters its GPL-2.0 IntpFMT table; the T20's register
values are documented in docs/t20-isp-hardware.md. Parameter sets and slice
headers are written here; the VPU writes the slice data.
---
diff --git a/drivers/media/platform/ingenic/Kconfig b/drivers/media/platform/ingenic/Kconfig
--- a/drivers/media/platform/ingenic/Kconfig
+++ b/drivers/media/platform/ingenic/Kconfig
@@ -17,3 +17,19 @@ config VIDEO_INGENIC_T20_ISP
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called t20-isp.
+
+config VIDEO_INGENIC_T20_VPU
+	tristate "Ingenic T20 VPU JPEG and H.264 encoders"
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on VIDEO_DEV && OF
+	depends on MACH_INGENIC || COMPILE_TEST
+	select V4L2_MEM2MEM_DEV
+	select VIDEOBUF2_DMA_CONTIG
+	select VIDEOBUF2_VMALLOC
+	select V4L2_JPEG_HELPER
+	help
+	  The encoders of the Ingenic T20 SoC's video processing unit:
+	  NV12 frames in, JPEG or H.264 out.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called t20-vpu.
diff --git a/drivers/media/platform/ingenic/Makefile b/drivers/media/platform/ingenic/Makefile
--- a/drivers/media/platform/ingenic/Makefile
+++ b/drivers/media/platform/ingenic/Makefile
@@ -1 +1,3 @@
 obj-$(CONFIG_VIDEO_INGENIC_T20_ISP) += t20-isp.o
+obj-$(CONFIG_VIDEO_INGENIC_T20_VPU) += t20-vpu.o
+t20-vpu-y := t20-vpu-core.o t20-vpu-jpeg.o t20-vpu-h264.o
diff --git a/drivers/media/platform/ingenic/t20-vpu.h b/drivers/media/platform/ingenic/t20-vpu.h
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/ingenic/t20-vpu.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Ingenic T20 VPU: the parts shared by its JPEG and H.264 encoders
+ */
+
+#ifndef T20_VPU_H
+#define T20_VPU_H
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-device.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-mem2mem.h>
+
+/* Scheduler */
+#define VPU_SCH_GLBC		0x00000
+#define SCH_GLBC_HIAXI		BIT(9)
+#define SCH_INTE_ENDF		BIT(16)
+#define SCH_INTE_BSERR		BIT(17)
+#define SCH_INTE_TLBERR		BIT(18)
+#define SCH_INTE_ACFGERR	BIT(20)
+#define SCH_INTE_ALL		(SCH_INTE_ENDF | SCH_INTE_BSERR | \
+				 SCH_INTE_TLBERR | SCH_INTE_ACFGERR)
+#define VPU_SCH_STAT		0x00034
+#define SCH_STAT_ENDF		BIT(0)
+#define SCH_STAT_JPGEND		BIT(4)
+
+/* Descriptor DMA: a list of (value, register) pairs */
+#define VPU_VDMA_TASKRG		0x10008
+#define VDMA_ACFG_RUN		BIT(0)
+#define ACFG_VLD		BIT(31)
+#define ACFG_TERM		BIT(30)
+#define ACFG_REG(r)		((r) & 0xffffc)
+
+#define VPU_TCSM_FLUSH		0xc0000
+#define VPU_VRAM		0xf0000		/* internal RAM: EFE macroblock FIFO */
+
+#define T20_VPU_DESC_SIZE	16384
+
+struct t20_vpu_ctx;
+
+/* A codec: its part of a job */
+struct t20_vpu_codec {
+	/* Write the descriptor list for the next frame (device_run) */
+	void (*run)(struct t20_vpu_ctx *ctx);
+	/* The job ended: status 0 on a timeout. Returns the buffers. */
+	void (*done)(struct t20_vpu_ctx *ctx, u32 stat);
+};
+
+struct t20_vpu {
+	struct device *dev;
+	void __iomem *regs;
+	void __iomem *srbc;
+	u32 phys;			/* bus address of the VPU */
+	struct clk *clk_gate;
+	struct clk *clk_core;
+	int irq;
+
+	struct v4l2_device v4l2_dev;
+	struct v4l2_m2m_dev *m2m_dev;	/* one job at a time, either codec */
+	struct video_device jpeg_vdev;
+	struct video_device h264_vdev;
+	struct mutex lock;		/* video devices and queues */
+
+	u32 *desc;			/* the job's descriptor list */
+	dma_addr_t desc_dma;
+	struct delayed_work timeout;
+	spinlock_t hw_lock;		/* the job being run */
+	struct t20_vpu_ctx *running;
+	ktime_t started;
+};
+
+/* The first member of each codec's file context */
+struct t20_vpu_ctx {
+	struct v4l2_fh fh;
+	struct t20_vpu *vpu;
+	const struct t20_vpu_codec *codec;
+};
+
+static inline u32 *t20_vpu_acfg(u32 *d, u32 reg, u32 val)
+{
+	*d++ = val;
+	*d++ = ACFG_VLD | ACFG_REG(reg);
+	return d;
+}
+
+/* The end of a descriptor list */
+static inline void t20_vpu_acfg_end(struct t20_vpu *vpu, u32 *d)
+{
+	d[-1] |= ACFG_TERM;
+	WARN_ON((void *)d > (void *)vpu->desc + T20_VPU_DESC_SIZE);
+}
+
+void t20_vpu_ctx_init(struct t20_vpu_ctx *ctx, struct t20_vpu *vpu,
+		      struct video_device *vdev, const struct t20_vpu_codec *codec);
+int t20_vpu_queue_init(struct t20_vpu_ctx *ctx, struct vb2_queue *src,
+		       struct vb2_queue *dst, const struct vb2_ops *ops,
+		       const struct vb2_mem_ops *dst_mem_ops);
+int t20_vpu_release(struct file *file);
+int t20_vpu_queue_setup(struct vb2_queue *q, u32 size, unsigned int *nbuffers,
+			unsigned int *nplanes, unsigned int sizes[]);
+void t20_vpu_return_bufs(struct t20_vpu_ctx *ctx, struct vb2_queue *q,
+			 enum vb2_buffer_state state);
+void t20_vpu_buf_queue(struct vb2_buffer *vb);
+
+extern const struct v4l2_file_operations t20_vpu_jpeg_fops;
+extern const struct v4l2_ioctl_ops t20_vpu_jpeg_ioctl_ops;
+extern const struct v4l2_file_operations t20_vpu_h264_fops;
+extern const struct v4l2_ioctl_ops t20_vpu_h264_ioctl_ops;
+
+#endif
diff --git a/drivers/media/platform/ingenic/t20-vpu-core.c b/drivers/media/platform/ingenic/t20-vpu-core.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/ingenic/t20-vpu-core.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic T20 VPU: JPEG and H.264 encoders as V4L2 mem2mem devices
+ *
+ * The VPU runs one job at a time: a list of register writes (VDMA
+ * descriptors) that a codec writes for each frame, then an interrupt. Both
+ * codecs' contexts share one mem2mem device, which runs their jobs in turn.
+ * This file has the device, the job and the parts common to the codecs;
+ * t20-vpu-jpeg.c and t20-vpu-h264.c have the codecs.
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-vmalloc.h>
+
+#include "t20-vpu.h"
+
+/* CPM SRBC: VPU stop request, stop acknowledge, reset */
+#define SRBC_VPU_SR		BIT(31)
+#define SRBC_VPU_STP		BIT(30)
+#define SRBC_VPU_ACK		BIT(29)
+
+#define T20_VPU_CLK_RATE	350000000
+#define T20_VPU_TIMEOUT_MS	1000
+
+/* Job */
+
+static int t20_vpu_reset(struct t20_vpu *vpu)
+{
+	u32 srbc = readl(vpu->srbc);
+	int timeout = 10000;
+
+	writel(srbc | SRBC_VPU_STP, vpu->srbc);
+	while (!(readl(vpu->srbc) & SRBC_VPU_ACK) && --timeout)
+		udelay(1);
+	if (!timeout) {
+		writel(srbc, vpu->srbc);
+		return -ETIMEDOUT;
+	}
+	writel(srbc | SRBC_VPU_SR, vpu->srbc);
+	writel(srbc & ~(SRBC_VPU_SR | SRBC_VPU_STP), vpu->srbc);
+	return 0;
+}
+
+static void t20_vpu_device_run(void *priv)
+{
+	struct t20_vpu_ctx *ctx = priv;
+	struct t20_vpu *vpu = ctx->vpu;
+	unsigned long flags;
+
+	ctx->codec->run(ctx);
+
+	if (t20_vpu_reset(vpu))
+		dev_warn(vpu->dev, "no reset acknowledge\n");
+	spin_lock_irqsave(&vpu->hw_lock, flags);
+	vpu->running = ctx;
+	spin_unlock_irqrestore(&vpu->hw_lock, flags);
+	schedule_delayed_work(&vpu->timeout, msecs_to_jiffies(T20_VPU_TIMEOUT_MS));
+	vpu->started = ktime_get();
+	writel(SCH_GLBC_HIAXI | SCH_INTE_ALL, vpu->regs + VPU_SCH_GLBC);
+	/* The descriptors must be visible to the VPU before it starts */
+	wmb();
+	writel((vpu->desc_dma & ~0x7f) | VDMA_ACFG_RUN, vpu->regs + VPU_VDMA_TASKRG);
+}
+
+static const struct v4l2_m2m_ops t20_vpu_m2m_ops = {
+	.device_run = t20_vpu_device_run,
+};
+
+static struct t20_vpu_ctx *t20_vpu_take_running(struct t20_vpu *vpu)
+{
+	struct t20_vpu_ctx *ctx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vpu->hw_lock, flags);
+	ctx = vpu->running;
+	vpu->running = NULL;
+	spin_unlock_irqrestore(&vpu->hw_lock, flags);
+	return ctx;
+}
+
+/* Threaded: the H.264 codec copies the slice data out here */
+static irqreturn_t t20_vpu_irq(int irq, void *data)
+{
+	struct t20_vpu *vpu = data;
+	struct t20_vpu_ctx *ctx;
+	u32 stat;
+
+	stat = readl(vpu->regs + VPU_SCH_STAT);
+	/* Interrupts off until the next job */
+	writel(readl(vpu->regs + VPU_SCH_GLBC) & ~SCH_INTE_ALL, vpu->regs + VPU_SCH_GLBC);
+
+	ctx = t20_vpu_take_running(vpu);
+	if (!ctx)
+		return IRQ_HANDLED;
+	cancel_delayed_work(&vpu->timeout);
+	dev_dbg(vpu->dev, "job done in %lld us, status %#x\n",
+		ktime_us_delta(ktime_get(), vpu->started), stat);
+	ctx->codec->done(ctx, stat);
+	v4l2_m2m_job_finish(vpu->m2m_dev, ctx->fh.m2m_ctx);
+	return IRQ_HANDLED;
+}
+
+static void t20_vpu_timeout(struct work_struct *work)
+{
+	static const u32 regs[] = { 0x00000, 0x00034, 0x1000c, 0x40000, 0x40110,
+				    0x70070, 0x80048, 0x90000, 0xe0008 };
+	struct t20_vpu *vpu = container_of(work, struct t20_vpu, timeout.work);
+	struct t20_vpu_ctx *ctx;
+	unsigned int i;
+
+	disable_irq(vpu->irq);
+	ctx = t20_vpu_take_running(vpu);
+	if (ctx) {
+		for (i = 0; i < ARRAY_SIZE(regs); i++)
+			dev_err(vpu->dev, "timeout: %05x = %08x\n", regs[i],
+				readl(vpu->regs + regs[i]));
+		writel(0, vpu->regs + VPU_SCH_GLBC);
+		t20_vpu_reset(vpu);
+		ctx->codec->done(ctx, 0);
+		v4l2_m2m_job_finish(vpu->m2m_dev, ctx->fh.m2m_ctx);
+	}
+	enable_irq(vpu->irq);
+}
+
+/* Common parts of the codecs */
+
+void t20_vpu_ctx_init(struct t20_vpu_ctx *ctx, struct t20_vpu *vpu,
+		      struct video_device *vdev, const struct t20_vpu_codec *codec)
+{
+	ctx->vpu = vpu;
+	ctx->codec = codec;
+	v4l2_fh_init(&ctx->fh, vdev);
+}
+
+/* Raw frames in (from the ISP as dma-bufs, or ours); the codec's buffers out */
+int t20_vpu_queue_init(struct t20_vpu_ctx *ctx, struct vb2_queue *src,
+		       struct vb2_queue *dst, const struct vb2_ops *ops,
+		       const struct vb2_mem_ops *dst_mem_ops)
+{
+	int ret;
+
+	src->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+	src->io_modes = VB2_MMAP | VB2_DMABUF;
+	src->drv_priv = ctx;
+	src->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	src->ops = ops;
+	src->mem_ops = &vb2_dma_contig_memops;
+	src->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src->lock = &ctx->vpu->lock;
+	src->dev = ctx->vpu->dev;
+	ret = vb2_queue_init(src);
+	if (ret)
+		return ret;
+
+	dst->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	dst->io_modes = VB2_MMAP;
+	if (dst_mem_ops == &vb2_vmalloc_memops)
+		dst->io_modes |= VB2_USERPTR;
+	dst->drv_priv = ctx;
+	dst->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst->ops = ops;
+	dst->mem_ops = dst_mem_ops;
+	dst->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst->lock = &ctx->vpu->lock;
+	dst->dev = ctx->vpu->dev;
+	return vb2_queue_init(dst);
+}
+
+int t20_vpu_release(struct file *file)
+{
+	struct t20_vpu_ctx *ctx = container_of(file->private_data, struct t20_vpu_ctx, fh);
+	struct t20_vpu *vpu = ctx->vpu;
+
+	mutex_lock(&vpu->lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	mutex_unlock(&vpu->lock);
+	v4l2_ctrl_handler_free(ctx->fh.ctrl_handler);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return 0;
+}
+
+int t20_vpu_queue_setup(struct vb2_queue *q, u32 size, unsigned int *nbuffers,
+			unsigned int *nplanes, unsigned int sizes[])
+{
+	if (*nplanes)
+		return sizes[0] < size ? -EINVAL : 0;
+	*nplanes = 1;
+	sizes[0] = size;
+	return 0;
+}
+
+void t20_vpu_return_bufs(struct t20_vpu_ctx *ctx, struct vb2_queue *q,
+			 enum vb2_buffer_state state)
+{
+	struct vb2_v4l2_buffer *vb;
+
+	for (;;) {
+		vb = V4L2_TYPE_IS_OUTPUT(q->type) ? v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+						    v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		if (!vb)
+			break;
+		v4l2_m2m_buf_done(vb, state);
+	}
+}
+
+void t20_vpu_buf_queue(struct vb2_buffer *vb)
+{
+	struct t20_vpu_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+/* Probe */
+
+static int t20_vpu_runtime_resume(struct device *dev)
+{
+	struct t20_vpu *vpu = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_prepare_enable(vpu->clk_core);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(vpu->clk_gate);
+	if (ret)
+		clk_disable_unprepare(vpu->clk_core);
+	return ret;
+}
+
+static int t20_vpu_runtime_suspend(struct device *dev)
+{
+	struct t20_vpu *vpu = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(vpu->clk_gate);
+	clk_disable_unprepare(vpu->clk_core);
+	return 0;
+}
+
+static int t20_vpu_register(struct t20_vpu *vpu, struct video_device *vdev,
+			    const char *name, const struct v4l2_file_operations *fops,
+			    const struct v4l2_ioctl_ops *ioctl_ops)
+{
+	int ret;
+
+	strscpy(vdev->name, name, sizeof(vdev->name));
+	vdev->fops = fops;
+	vdev->ioctl_ops = ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &vpu->lock;
+	vdev->v4l2_dev = &vpu->v4l2_dev;
+	vdev->vfl_dir = VFL_DIR_M2M;
+	vdev->device_caps = V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, vpu);
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (!ret)
+		dev_info(vpu->dev, "%s at /dev/video%d\n", name, vdev->num);
+	return ret;
+}
+
+static int t20_vpu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct t20_vpu *vpu;
+	struct resource *res;
+	int ret;
+
+	vpu = devm_kzalloc(dev, sizeof(*vpu), GFP_KERNEL);
+	if (!vpu)
+		return -ENOMEM;
+	vpu->dev = dev;
+	mutex_init(&vpu->lock);
+	spin_lock_init(&vpu->hw_lock);
+	INIT_DELAYED_WORK(&vpu->timeout, t20_vpu_timeout);
+	platform_set_drvdata(pdev, vpu);
+
+	vpu->regs = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(vpu->regs))
+		return PTR_ERR(vpu->regs);
+	vpu->phys = res->start;
+	/* In the CGU's register block, so mapped without claiming it */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "srbc");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no srbc register\n");
+	vpu->srbc = devm_ioremap(dev, res->start, resource_size(res));
+	if (!vpu->srbc)
+		return -ENOMEM;
+
+	vpu->clk_gate = devm_clk_get(dev, "vpu");
+	if (IS_ERR(vpu->clk_gate))
+		return dev_err_probe(dev, PTR_ERR(vpu->clk_gate), "vpu clock\n");
+	vpu->clk_core = devm_clk_get(dev, "core");
+	if (IS_ERR(vpu->clk_core))
+		return dev_err_probe(dev, PTR_ERR(vpu->clk_core), "core clock\n");
+	ret = clk_set_rate(vpu->clk_core, T20_VPU_CLK_RATE);
+	if (ret)
+		return dev_err_probe(dev, ret, "core clock rate\n");
+
+	vpu->irq = platform_get_irq(pdev, 0);
+	if (vpu->irq < 0)
+		return vpu->irq;
+	ret = devm_request_threaded_irq(dev, vpu->irq, NULL, t20_vpu_irq, IRQF_ONESHOT,
+					dev_name(dev), vpu);
+	if (ret)
+		return ret;
+
+	/* Buffers from the reserved camera memory, shared with the ISP */
+	ret = of_reserved_mem_device_init(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "no memory-region\n");
+	vpu->desc = dma_alloc_coherent(dev, T20_VPU_DESC_SIZE, &vpu->desc_dma, GFP_KERNEL);
+	if (!vpu->desc) {
+		ret = -ENOMEM;
+		goto err_mem;
+	}
+
+	ret = v4l2_device_register(dev, &vpu->v4l2_dev);
+	if (ret)
+		goto err_desc;
+	vpu->m2m_dev = v4l2_m2m_init(&t20_vpu_m2m_ops);
+	if (IS_ERR(vpu->m2m_dev)) {
+		ret = PTR_ERR(vpu->m2m_dev);
+		goto err_v4l2;
+	}
+
+	/* Clocks on here: without CONFIG_PM runtime PM never turns them on */
+	ret = t20_vpu_runtime_resume(dev);
+	if (ret)
+		goto err_m2m;
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = t20_vpu_register(vpu, &vpu->jpeg_vdev, "t20-jpeg", &t20_vpu_jpeg_fops,
+			       &t20_vpu_jpeg_ioctl_ops);
+	if (ret)
+		goto err_pm;
+	ret = t20_vpu_register(vpu, &vpu->h264_vdev, "t20-h264", &t20_vpu_h264_fops,
+			       &t20_vpu_h264_ioctl_ops);
+	if (ret)
+		goto err_jpeg;
+	return 0;
+
+err_jpeg:
+	video_unregister_device(&vpu->jpeg_vdev);
+err_pm:
+	pm_runtime_disable(dev);
+	if (!pm_runtime_status_suspended(dev))
+		t20_vpu_runtime_suspend(dev);
+	pm_runtime_set_suspended(dev);
+err_m2m:
+	v4l2_m2m_release(vpu->m2m_dev);
+err_v4l2:
+	v4l2_device_unregister(&vpu->v4l2_dev);
+err_desc:
+	dma_free_coherent(dev, T20_VPU_DESC_SIZE, vpu->desc, vpu->desc_dma);
+err_mem:
+	of_reserved_mem_device_release(dev);
+	return ret;
+}
+
+static void t20_vpu_remove(struct platform_device *pdev)
+{
+	struct t20_vpu *vpu = platform_get_drvdata(pdev);
+
+	video_unregister_device(&vpu->h264_vdev);
+	video_unregister_device(&vpu->jpeg_vdev);
+	cancel_delayed_work_sync(&vpu->timeout);
+	pm_runtime_disable(vpu->dev);
+	if (!pm_runtime_status_suspended(vpu->dev))
+		t20_vpu_runtime_suspend(vpu->dev);
+	pm_runtime_set_suspended(vpu->dev);
+	v4l2_m2m_release(vpu->m2m_dev);
+	v4l2_device_unregister(&vpu->v4l2_dev);
+	dma_free_coherent(vpu->dev, T20_VPU_DESC_SIZE, vpu->desc, vpu->desc_dma);
+	of_reserved_mem_device_release(vpu->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(t20_vpu_pm_ops, t20_vpu_runtime_suspend,
+				 t20_vpu_runtime_resume, NULL);
+
+static const struct of_device_id t20_vpu_of_match[] = {
+	{ .compatible = "ingenic,t20-vpu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, t20_vpu_of_match);
+
+static struct platform_driver t20_vpu_driver = {
+	.driver = {
+		.name = "t20-vpu",
+		.of_match_table = t20_vpu_of_match,
+		.pm = pm_ptr(&t20_vpu_pm_ops),
+	},
+	.probe = t20_vpu_probe,
+	.remove = t20_vpu_remove,
+};
+module_platform_driver(t20_vpu_driver);
+
+MODULE_DESCRIPTION("Ingenic T20 VPU JPEG and H.264 encoders");
+MODULE_LICENSE("GPL");
