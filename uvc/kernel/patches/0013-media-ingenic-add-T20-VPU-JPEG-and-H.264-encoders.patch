+/* Encoder front end */
+#define VPU_EFE_CTRL		0x40000
+#define EFE_ID_JPEG		(1 << 14)
+#define EFE_PLANE_NV12		(2 << 2)
+#define EFE_EN			BIT(1)
+#define EFE_RUN			BIT(0)
+#define VPU_EFE_GEOM		0x40004		/* last MB row << 16 | last MB column */
+#define VPU_EFE_RAWY_SBA	0x40010
+#define VPU_EFE_RAWC_SBA	0x40014
+#define VPU_EFE_RAW_DBA		0x40030
+#define VPU_EFE_RAWV_SBA	0x40034
+#define VPU_EFE_RAW_STRD	0x40038		/* Y stride << 16 | C stride */
+
+/* JPEG codec */
+#define VPU_JPGC_TRIG		0xe0000
+#define JPGC_CORE_OPEN		BIT(0)
+#define JPGC_BS_TRIG		BIT(1)
+#define JPGC_PP_TRIG		BIT(2)
+#define VPU_JPGC_GLBI		0xe0004
+#define JPGC_EN			BIT(0)
+#define JPGC_NCOL_3		(2 << 4)	/* components - 1 */
+#define JPGC_EFE		BIT(8)		/* MCUs from the EFE */
+#define JPGC_MCU_420		(0x0a << 16)	/* Y 2x2 blocks, Cb and Cr 1x1 */
+#define VPU_JPGC_STAT		0xe0008
+#define JPGC_STAT_ENDF		BIT(31)
+#define JPGC_STAT_SIZE		GENMASK(23, 0)	/* bitstream bytes */
+#define VPU_JPGC_BSA		0xe000c
+#define VPU_JPGC_P0A		0xe0010
+#define VPU_JPGC_NMCU		0xe0028
+#define VPU_JPGC_NRSM		0xe002c
+#define VPU_JPGC_PC(n)		(0xe0030 + 4 * (n))
+/* Component: blocks - 1 << 4 | table << 2 | AC table << 1 | DC table */
+#define JPGC_PC_Y		0x30
+#define JPGC_PC_C		0x07
+#define VPU_JPGC_QMEM		0xe1400
+#define VPU_JPGC_HUFE		0xe1800
+
+#define T20_JPEG_MIN_SIZE	32
+#define T20_JPEG_MAX_SIZE	4096
+#define T20_JPEG_QMEM_LEN	256
+#define T20_JPEG_HEADER_ALIGN	256	/* the bitstream address */
+
