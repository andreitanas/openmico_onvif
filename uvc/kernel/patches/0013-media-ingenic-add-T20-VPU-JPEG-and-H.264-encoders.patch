+struct t20_h264_ctx {
+	struct t20_vpu_ctx vpu_ctx;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_pix_format out_fmt;	/* NV12 */
+	struct v4l2_pix_format cap_fmt;	/* H.264 */
+	u32 mbw, mbh;
+
+	/* Controls */
+	u32 gop_size;
+	u32 i_qp, p_qp;			/* without rate control */
+	bool force_key;
+	bool rc;
+	u32 bitrate;
+	u32 min_qp, max_qp;
+	struct v4l2_fract timeperframe;
+
+	/* Rate control: the P frame QP, the bits over the budget so far */
+	u32 rc_qp;
+	s64 rc_debt;
+
+	/* Streaming state */
+	void *ref;			/* two reconstructed frames */
+	dma_addr_t ref_dma;
+	size_t ref_size;
+	void *bs;			/* the hardware's slice data, cached */
+	void *bs_alloc;
+	dma_addr_t bs_dma;
+	size_t bs_size;
+	unsigned int cur;		/* reconstructed frame written next */
+	bool idr;			/* the frame being encoded */
+	u32 qp;
+	u32 gop_pos;
+	u32 frame_num;
+	u32 idr_pic_id;
+	u8 hdr[T20_H264_HDR_SIZE];	/* the frame's NAL units up to the slice data */
+	u32 hdr_len;
+	unsigned int hdr_zeros;		/* zero bytes at the end of hdr */
+};
+
+static inline struct t20_h264_ctx *to_h264_ctx(struct t20_vpu_ctx *ctx)
+{
+	return container_of(ctx, struct t20_h264_ctx, vpu_ctx);
+}
+
+static inline struct t20_h264_ctx *file_to_ctx(struct file *file)
+{
+	return container_of(file->private_data, struct t20_h264_ctx, vpu_ctx.fh);
+}
