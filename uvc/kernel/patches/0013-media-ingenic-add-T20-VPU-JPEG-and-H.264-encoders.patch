+/*
+ * Ingenic T20 VPU JPEG encoder: NV12 in, baseline JFIF (4:2:0) out.
+ *
+ * The descriptor list loads the Huffman and quantisation tables and sets up
+ * the JPEG codec (JPGC), then the encoder front end (EFE), which reads the
+ * frame one macroblock at a time into the VPU's internal RAM for the JPGC.
+ * The sequence, the registers and the Huffman encoder table are from
+ * Ingenic's GPL-2.0 kernel drivers for the same VPU blocks (the X1000 JPEG
+ * driver and the T31 helix codec driver, Copyright (C) 2012-2014 Ingenic
+ * Semiconductor Co., Ltd.). The V4L2 side, the JFIF headers and the
+ * quantisation tables (from a quality setting) are new.
+ */
+
+#include <linux/io.h>
