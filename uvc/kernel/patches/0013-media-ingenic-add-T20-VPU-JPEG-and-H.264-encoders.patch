+/*
+ * Motion compensation filters for the 16 quarter-pel positions (H0V0 to
+ * H3V3), from the H264_QPEL and H264_EPEL entries of Ingenic's GPL-2.0
+ * IntpFMT table packed as helix.h's MCE_ILUT_INFO (two filter passes) and
+ * MCE_CLUT_INFO (taps). Luma: the 6-tap filter, rounding 16, shift 5;
+ * chroma: bilinear, only on the half-pel grid as in the vendor's table.
+ */
+static const u32 t20_h264_luma_ilut[16][2] = {
+	{ 0x00000000, 0x00000000 },	/* H0V0 */
+	{ 0x80100506, 0x00000000 },	/* H1V0 */
+	{ 0x80100500, 0x00000000 },	/* H2V0 */
+	{ 0x80100507, 0x00000000 },	/* H3V0 */
+	{ 0x81100506, 0x00000000 },	/* H0V1 */
+	{ 0x8c100500, 0x8d100506 },	/* H1V1 */
+	{ 0x80100500, 0x81000a06 },	/* H2V1 */
+	{ 0x8c100501, 0x8d100506 },	/* H3V1 */
+	{ 0x81100500, 0x00000000 },	/* H0V2 */
+	{ 0x81100500, 0x80000a06 },	/* H1V2 */
+	{ 0x80100500, 0x81000a00 },	/* H2V2 */
+	{ 0x81100500, 0x80000a07 },	/* H3V2 */
+	{ 0x81100507, 0x00000000 },	/* H0V3 */
+	{ 0x8c100500, 0x8d100507 },	/* H1V3 */
+	{ 0x80100500, 0x81000a07 },	/* H2V3 */
+	{ 0x8c100501, 0x8d100507 },	/* H3V3 */
+};
+#define T20_H264_LUMA_TAPS_L	0x1414fb01	/* 1, -5, 20, 20 */
+#define T20_H264_LUMA_TAPS_M	0x000001fb	/* -5, 1 */
+
+static const u32 t20_h264_chroma_ilut[16][2] = {
+	[2]  = { 0x80040300, 0 },		/* H2V0: horizontal, (s + 4) >> 3 */
+	[8]  = { 0x81040300, 0 },		/* H0V2: vertical */
+	[10] = { 0x80000000, 0x81200600 },	/* H2V2: both, (s + 32) >> 6 */
+};
