+/* Controls */
+
+static int t20_isp_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct t20_isp *isp = container_of(ctrl->handler, struct t20_isp, ctrls);
+
+	/* The gains the AWB found */
+	if (ctrl->id == V4L2_CID_AUTO_WHITE_BALANCE) {
+		isp->red->val = isp->wb_red;
+		isp->blue->val = isp->wb_blue;
+	}
+	return 0;
+}
+
+static int t20_isp_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct t20_isp *isp = container_of(ctrl->handler, struct t20_isp, ctrls);
+
+	switch (ctrl->id) {
+	case V4L2_CID_AUTO_WHITE_BALANCE:
+		if (!ctrl->val) {
+			isp->wb_red = isp->red->val;
+			isp->wb_blue = isp->blue->val;
+		}
+		WRITE_ONCE(isp->awb_on, ctrl->val);
+		t20_isp_set_wb(isp, isp->wb_red, isp->wb_blue);
+		return 0;
+	case V4L2_CID_BRIGHTNESS:
+		t20_isp_set_csc(&isp->paths[T20_ISP_MAIN]);
+		t20_isp_set_csc(&isp->paths[T20_ISP_SUB]);
+		return 0;
+	case T20_ISP_CID_NOISE_REDUCTION:
+		t20_isp_set_sinter(isp, ctrl->val);
+		return 0;
+	case V4L2_CID_SHARPNESS:
+		t20_isp_set_sharpen(isp, ctrl->val);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static const struct v4l2_ctrl_ops t20_isp_ctrl_ops = {
+	.g_volatile_ctrl = t20_isp_g_volatile_ctrl,
+	.s_ctrl = t20_isp_s_ctrl,
+};
+
+static const struct v4l2_ctrl_config t20_isp_noise_reduction = {
+	.ops = &t20_isp_ctrl_ops,
+	.id = T20_ISP_CID_NOISE_REDUCTION,
+	.name = "Noise Reduction",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.max = 255,
+	.step = 1,
+	.def = T20_ISP_NOISE_REDUCTION_DEFAULT,
+};
+
+static int t20_isp_init_ctrls(struct t20_isp *isp)
+{
+	struct v4l2_ctrl_handler *h = &isp->ctrls;
+	const struct v4l2_ctrl_ops *ops = &t20_isp_ctrl_ops;
+
+	isp->wb_red = ISP_WB_GAIN_ONE;
+	isp->wb_blue = ISP_WB_GAIN_ONE;
+	v4l2_ctrl_handler_init(h, 8);
+	isp->awb = v4l2_ctrl_new_std(h, ops, V4L2_CID_AUTO_WHITE_BALANCE, 0, 1, 1, 1);
+	isp->red = v4l2_ctrl_new_std(h, ops, V4L2_CID_RED_BALANCE, 0,
+				     ISP_WB_GAIN_MAX, 1, ISP_WB_GAIN_ONE);
+	isp->blue = v4l2_ctrl_new_std(h, ops, V4L2_CID_BLUE_BALANCE, 0,
+				      ISP_WB_GAIN_MAX, 1, ISP_WB_GAIN_ONE);
+	isp->brightness = v4l2_ctrl_new_std(h, ops, V4L2_CID_BRIGHTNESS, -128, 127, 1, 0);
+	isp->contrast = v4l2_ctrl_new_std(h, ops, V4L2_CID_CONTRAST, 0, 255, 1, 128);
+	isp->saturation = v4l2_ctrl_new_std(h, ops, V4L2_CID_SATURATION, 0, 255, 1, 128);
+	v4l2_ctrl_new_custom(h, &t20_isp_noise_reduction, NULL);
+	v4l2_ctrl_new_std(h, ops, V4L2_CID_SHARPNESS, 0, 255, 1, T20_ISP_SHARPNESS_DEFAULT);
+	if (h->error)
+		return h->error;
+	v4l2_ctrl_auto_cluster(3, &isp->awb, 0, true);
+	v4l2_ctrl_cluster(3, &isp->brightness);
+	isp->sd.ctrl_handler = h;
+	isp->paths[T20_ISP_MAIN].vdev.ctrl_handler = h;
+	isp->paths[T20_ISP_SUB].vdev.ctrl_handler = h;
+	return 0;
+}
+
+/* ISP subdevice: Bayer in, YUV out at the same size */
+
+static int t20_isp_sd_enum_mbus_code(struct v4l2_subdev *sd,
+				     struct v4l2_subdev_state *state,
+				     struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad == T20_ISP_PAD_SINK) {
+		if (code->index >= ARRAY_SIZE(t20_isp_bayer))
+			return -EINVAL;
+		code->code = t20_isp_bayer[code->index];
+		return 0;
+	}
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_YUV10_1X30;
+	return 0;
+}
+
+static int t20_isp_sd_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *sink = v4l2_subdev_state_get_format(state, T20_ISP_PAD_SINK);
+	struct v4l2_mbus_framefmt *src;
+	unsigned int pad;
+
+	if (fmt->pad != T20_ISP_PAD_SINK) {
+		fmt->format = *v4l2_subdev_state_get_format(state, fmt->pad);
+		return 0;
+	}
+	*sink = fmt->format;
+	sink->code = t20_isp_bayer[t20_isp_rggb_start(fmt->format.code)];
+	sink->field = V4L2_FIELD_NONE;
+	fmt->format = *sink;
+	/* Both sources at the sink's size; the second path's video node scales */
+	for (pad = T20_ISP_PAD_SOURCE; pad <= T20_ISP_PAD_SOURCE_SUB; pad++) {
+		src = v4l2_subdev_state_get_format(state, pad);
+		*src = *sink;
+		src->code = MEDIA_BUS_FMT_YUV10_1X30;
+		src->colorspace = V4L2_COLORSPACE_SMPTE170M;
+	}
+	return 0;
+}
+
+static int t20_isp_sd_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = T20_ISP_PAD_SINK,
+		.format = {
+			.width = 1920,
+			.height = 1080,
+			.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+			.colorspace = V4L2_COLORSPACE_RAW,
+		},
+	};
+
+	return t20_isp_sd_set_fmt(sd, state, &fmt);
+}
