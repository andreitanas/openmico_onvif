 obj-$(CONFIG_INGENIC_CGU_JZ4780)	+= jz4780-cgu.o
 obj-$(CONFIG_INGENIC_CGU_X1000)		+= x1000-cgu.o
 obj-$(CONFIG_INGENIC_CGU_X1830)		+= x1830-cgu.o
+obj-$(CONFIG_INGENIC_CGU_T20)		+= t20-cgu.o
 obj-$(CONFIG_INGENIC_TCU_CLK)		+= tcu.o
diff --git a/drivers/clk/ingenic/t20-cgu.c b/drivers/clk/ingenic/t20-cgu.c
new file mode 100644
index 000000000..beacae28f
--- /dev/null
+++ b/drivers/clk/ingenic/t20-cgu.c
@@ -0,0 +1,461 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic T20 SoC CGU driver
+ *
+ * Register layout from Ingenic's 3.10.14 tree (arch/mips/xburst/soc-t20/
+ * common/clk), structure after the T31 driver.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/clkdev.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/of.h>
+#include <linux/rational.h>
+
+#include <dt-bindings/clock/ingenic,t20-cgu.h>
+
+#include "cgu.h"
+#include "pm.h"
+
+/* CGU register offsets */
+#define CGU_REG_CPCCR		0x00
+#define CGU_REG_APLL		0x10
+#define CGU_REG_MPLL		0x14
+#define CGU_REG_CLKGR0		0x20
+#define CGU_REG_OPCR		0x24
+#define CGU_REG_CLKGR1		0x28
+#define CGU_REG_DDRCDR		0x2c
+#define CGU_REG_VPUCDR		0x30
+#define CGU_REG_I2SCDR		0x60
+#define CGU_REG_LPCDR		0x64
+#define CGU_REG_MSC0CDR		0x68
+#define CGU_REG_I2SCDR1		0x70
+#define CGU_REG_SSICDR		0x74
+#define CGU_REG_CIMCDR		0x7c
+#define CGU_REG_ISPCDR		0x80
+#define CGU_REG_MSC1CDR		0xa4
+#define CGU_REG_VPLL		0xe0
+
+static struct ingenic_cgu *cgu;
+
+/*
+ * The PLLs are only read: the bootloader sets them up and nothing here
+ * changes them. Unlike the T31 driver's model, both output dividers
+ * (OD1 bits 13:11, OD0 bits 10:8) and the fractional part (as read by the
+ * vendor kernel) count.
+ */
+static unsigned int t20_pll_reg(struct clk_hw *hw)
+{
+	switch (to_ingenic_clk(hw)->idx) {
+	case T20_CLK_APLL:
+		return CGU_REG_APLL;
+	case T20_CLK_MPLL:
+		return CGU_REG_MPLL;
+	default:
+		return CGU_REG_VPLL;
+	}
+}
+
+static unsigned long t20_pll_recalc_rate(struct clk_hw *hw,
+					 unsigned long parent_rate)
+{
+	unsigned int reg = t20_pll_reg(hw);
+	u32 ctl = readl(cgu->base + reg);
+	u32 m, n, od1, od0, frac, fv;
+	u64 rate;
+
+	if (!(ctl & BIT(0)))
+		return 0;
+
+	m = (ctl >> 20) & 0xfff;
+	n = (ctl >> 14) & 0x3f;
+	od1 = (ctl >> 11) & 0x7;
+	od0 = (ctl >> 8) & 0x7;
+	if (!n || !od1 || !od0)
+		return 0;
+
+	frac = readl(cgu->base + reg + (reg == CGU_REG_VPLL ? 4 : 8));
+	fv = DIV_ROUND_CLOSEST(frac * 125ULL, 0x200000);
+	if (fv >= 1000)
+		fv = 0;
+
+	rate = (u64)parent_rate * (m * 1000 + fv);
+	return div_u64(rate, 1000 * n * od1 * od0);
+}
+
+static int t20_pll_is_enabled(struct clk_hw *hw)
+{
+	return !!(readl(cgu->base + t20_pll_reg(hw)) & BIT(0));
+}
+
+static const struct clk_ops t20_pll_ops = {
+	.recalc_rate	= t20_pll_recalc_rate,
+	.is_enabled	= t20_pll_is_enabled,
+};
+
+/*
+ * The audio clock's fractional divider (I2SCDR: M bits 21:13, N bits 12:0,
+ * rate = parent * M / N), as the X1000's (same register): the best M/N for
+ * the rate, N at least 2 M.
+ */
+static void t20_i2spll_calc_m_n_od(const struct ingenic_cgu_pll_info *pll_info,
+				   unsigned long rate, unsigned long parent_rate,
+				   unsigned int *pm, unsigned int *pn, unsigned int *pod)
+{
+	const unsigned long m_max = GENMASK(pll_info->m_bits - 1, 0);
+	const unsigned long n_max = GENMASK(pll_info->n_bits - 1, 0);
+	unsigned long m, n;
+
+	rational_best_approximation(rate, parent_rate, m_max, n_max, &m, &n);
+	if (n < 2 * m)
+		n = 2 * m;
+	*pm = m;
+	*pn = n;
+	*pod = 1;
+}
+
+/* I2SCDR1 written 0 recalculates its I2SDIV_D from the new N */
+static void t20_i2spll_set_rate_hook(const struct ingenic_cgu_pll_info *pll_info,
+				     unsigned long rate, unsigned long parent_rate)
+{
+	writel(0, cgu->base + CGU_REG_I2SCDR1);
+}
+
+#define T20_PLL(_name) {					\
+	_name, CGU_CLK_CUSTOM,					\
+	.parents = { T20_CLK_EXCLK, -1, -1, -1 },		\
+	.custom = { &t20_pll_ops },				\
+}
+
+static const struct ingenic_cgu_clk_info t20_cgu_clocks[] = {
+
+	/* External clocks */
+
+	[T20_CLK_EXCLK] = { "ext", CGU_CLK_EXT },
+	[T20_CLK_RTCLK] = { "rtc", CGU_CLK_EXT },
+
+	/* PLLs */
+
+	[T20_CLK_APLL] = T20_PLL("apll"),
+	[T20_CLK_MPLL] = T20_PLL("mpll"),
+	[T20_CLK_VPLL] = T20_PLL("vpll"),
+
+	/* Muxes & dividers */
+
+	[T20_CLK_SCLKA] = {
+		"sclk_a", CGU_CLK_MUX,
+		.parents = { -1, T20_CLK_EXCLK, T20_CLK_APLL, -1 },
+		.mux = { CGU_REG_CPCCR, 30, 2 },
+	},
+
+	[T20_CLK_CPUMUX] = {
+		"cpu_mux", CGU_CLK_MUX,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, T20_CLK_SCLKA, T20_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 28, 2 },
+	},
+
+	[T20_CLK_CPU] = {
+		"cpu", CGU_CLK_DIV | CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { T20_CLK_CPUMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 0, 1, 4, 22, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 15 },
+	},
+
+	[T20_CLK_L2CACHE] = {
+		"l2cache", CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { T20_CLK_CPUMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 4, 1, 4, 22, -1, -1 },
+	},
+
+	[T20_CLK_AHB0] = {
+		"ahb0", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, T20_CLK_SCLKA, T20_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 26, 2 },
+		.div = { CGU_REG_CPCCR, 8, 1, 4, 21, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 10 },
+	},
+
+	[T20_CLK_AHB2] = {
+		"ahb2", CGU_CLK_MUX | CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, T20_CLK_SCLKA, T20_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 24, 2 },
+		.div = { CGU_REG_CPCCR, 12, 1, 4, 20, -1, -1 },
+	},
+
+	[T20_CLK_PCLK] = {
+		"pclk", CGU_CLK_DIV | CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { T20_CLK_AHB2, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 16, 1, 4, 20, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 14 },
+	},
+
+	[T20_CLK_DDR] = {
+		"ddr", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, T20_CLK_SCLKA, T20_CLK_MPLL, -1 },
+		.mux = { CGU_REG_DDRCDR, 30, 2 },
+		.div = { CGU_REG_DDRCDR, 0, 1, 4, 29, 28, 27 },
+		.gate = { CGU_REG_CLKGR0, 31 },
+	},
+
+	[T20_CLK_VPU] = {
+		"cgu_vpu", CGU_CLK_MUX | CGU_CLK_DIV,
+		.parents = { T20_CLK_SCLKA, T20_CLK_MPLL, T20_CLK_VPLL, -1 },
+		.mux = { CGU_REG_VPUCDR, 30, 2 },
+		.div = { CGU_REG_VPUCDR, 0, 1, 4, 29, 28, 27 },
+	},
+
+	/* MSC0 and MSC1 share the source selected in MSC0CDR bit 31 */
+	[T20_CLK_MSCMUX] = {
+		"msc_mux", CGU_CLK_MUX,
+		.parents = { T20_CLK_SCLKA, T20_CLK_MPLL, -1, -1 },
+		.mux = { CGU_REG_MSC0CDR, 31, 1 },
+	},
+
+	[T20_CLK_MSC0] = {
+		"msc0", CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { T20_CLK_MSCMUX, -1, -1, -1 },
+		.div = { CGU_REG_MSC0CDR, 0, 2, 8, 29, 28, 27 },
+		.gate = { CGU_REG_CLKGR0, 4 },
+	},
+
+	[T20_CLK_MSC1] = {
+		"msc1", CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { T20_CLK_MSCMUX, -1, -1, -1 },
+		.div = { CGU_REG_MSC1CDR, 0, 2, 8, 29, 28, 27 },
+		.gate = { CGU_REG_CLKGR0, 5 },
+	},
+
+	[T20_CLK_SSIPLL] = {
+		"cgu_ssi", CGU_CLK_MUX | CGU_CLK_DIV,
+		.parents = { T20_CLK_SCLKA, T20_CLK_MPLL, -1, -1 },
+		.mux = { CGU_REG_SSICDR, 31, 1 },
+		.div = { CGU_REG_SSICDR, 0, 1, 8, 29, 28, 27 },
+	},
+
+	[T20_CLK_CIM] = {
+		"cgu_cim", CGU_CLK_MUX | CGU_CLK_DIV,
+		.parents = { T20_CLK_SCLKA, T20_CLK_MPLL, T20_CLK_VPLL, -1 },
+		.mux = { CGU_REG_CIMCDR, 30, 2 },
+		.div = { CGU_REG_CIMCDR, 0, 1, 8, 29, 28, 27 },
+	},
+
+	[T20_CLK_ISP] = {
+		"cgu_isp", CGU_CLK_MUX | CGU_CLK_DIV,
+		.parents = { T20_CLK_SCLKA, T20_CLK_MPLL, T20_CLK_VPLL, -1 },
+		.mux = { CGU_REG_ISPCDR, 30, 2 },
+		.div = { CGU_REG_ISPCDR, 0, 1, 4, 29, 28, 27 },
+	},
+
+	/* Gate-only clocks (CLKGR0 unless noted) */
+
+	[T20_CLK_OTG] = {
+		"otg", CGU_CLK_GATE,
+		.parents = { T20_CLK_EXCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 3 },
+	},
+
+	[T20_CLK_SSI0] = {
+		"ssi0", CGU_CLK_GATE,
+		.parents = { T20_CLK_SSIPLL, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 6 },
+	},
+
+	[T20_CLK_I2C0] = {
+		"i2c0", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 7 },
+	},
+
+	[T20_CLK_I2C1] = {
+		"i2c1", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 8 },
+	},
+
+	[T20_CLK_I2SPLLMUX] = {
+		"i2s_pll_mux", CGU_CLK_MUX,
+		.parents = { T20_CLK_SCLKA, T20_CLK_MPLL, -1, -1 },
+		.mux = { CGU_REG_I2SCDR, 31, 1 },
+	},
+
+	[T20_CLK_I2SPLL] = {
+		"i2s_pll", CGU_CLK_PLL,
+		.parents = { T20_CLK_I2SPLLMUX, -1, -1, -1 },
+		.pll = {
+			.reg = CGU_REG_I2SCDR,
+			.rate_multiplier = 1,
+			.m_shift = 13,
+			.m_bits = 9,
+			.n_shift = 0,
+			.n_bits = 13,
+			.bypass_bit = -1,
+			.enable_bit = -1,
+			.stable_bit = -1,
+			.calc_m_n_od = t20_i2spll_calc_m_n_od,
+			.set_rate_hook = t20_i2spll_set_rate_hook,
+		},
+	},
+
+	/* Bit 30 selects the M/N divider, bit 29 enables it: both or neither */
+	[T20_CLK_I2S] = {
+		"i2s", CGU_CLK_MUX,
+		.parents = { T20_CLK_EXCLK, -1, -1, T20_CLK_I2SPLL },
+		.mux = { CGU_REG_I2SCDR, 29, 2 },
+	},
+
+	[T20_CLK_AIC] = {
+		"aic", CGU_CLK_GATE,
+		.parents = { T20_CLK_EXCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 11 },
+	},
+
+	[T20_CLK_DMIC] = {
+		"dmic", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 12 },
+	},
+
+	[T20_CLK_SADC] = {
+		"sadc", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 13 },
+	},
+
+	[T20_CLK_UART0] = {
+		"uart0", CGU_CLK_GATE,
+		.parents = { T20_CLK_EXCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 14 },
+	},
+
+	[T20_CLK_UART1] = {
+		"uart1", CGU_CLK_GATE,
+		.parents = { T20_CLK_EXCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 15 },
+	},
+
+	[T20_CLK_SFC] = {
+		"sfc", CGU_CLK_GATE,
+		.parents = { T20_CLK_SSIPLL, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 20 },
+	},
+
+	[T20_CLK_PDMA] = {
+		"pdma", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 21 },
+	},
+
+	[T20_CLK_ISP_GATE] = {
+		"isp", CGU_CLK_GATE,
+		.parents = { T20_CLK_ISP, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 23 },
+	},
+
+	[T20_CLK_LCD] = {
+		"lcd", CGU_CLK_GATE,
+		.parents = { T20_CLK_AHB0, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 24 },
+	},
+
+	[T20_CLK_CSI] = {
+		"csi", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 25 },
+	},
+
+	[T20_CLK_DES] = {
+		"des", CGU_CLK_GATE,
+		.parents = { T20_CLK_PCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 28 },
+	},
+
+	[T20_CLK_TCU] = {
+		"tcu_gate", CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { T20_CLK_EXCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR0, 30 },
+	},
+
+	[T20_CLK_VPU_GATE] = {
+		"vpu", CGU_CLK_GATE,
+		.parents = { T20_CLK_VPU, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 0 },
+	},
+
+	[T20_CLK_IPU] = {
+		"ipu", CGU_CLK_GATE,
+		.parents = { T20_CLK_AHB0, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 2 },
+	},
+
+	[T20_CLK_AES] = {
+		"aes", CGU_CLK_GATE,
+		.parents = { T20_CLK_AHB2, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 5 },
+	},
+
+	[T20_CLK_OST] = {
+		"ost", CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { T20_CLK_EXCLK, -1, -1, -1 },
+		.gate = { CGU_REG_CLKGR1, 11 },
+	},
+
+	[T20_CLK_EXCLK_DIV512] = {
+		"exclk_div512", CGU_CLK_FIXDIV,
+		.parents = { T20_CLK_EXCLK },
+		.fixdiv = { 512 },
+	},
+
+	[T20_CLK_RTC] = {
+		"rtc_ercs", CGU_CLK_MUX | CGU_CLK_GATE,
+		.parents = { T20_CLK_EXCLK_DIV512, T20_CLK_RTCLK, -1, -1 },
+		.mux = { CGU_REG_OPCR, 2, 1 },
+		.gate = { CGU_REG_CLKGR0, 29 },
+	},
+};
+
+static void __init t20_cgu_init(struct device_node *np)
+{
+	unsigned int i;
+	int retval;
+
+	cgu = ingenic_cgu_new(t20_cgu_clocks, ARRAY_SIZE(t20_cgu_clocks), np);
+	if (!cgu) {
+		pr_err("%s: failed to initialise CGU\n", __func__);
+		return;
+	}
+
+	retval = ingenic_cgu_register_clocks(cgu);
+	if (retval) {
+		pr_err("%s: failed to register CGU clocks\n", __func__);
+		return;
+	}
+
+	/*
+	 * Vendor-derived drivers (tx-isp, VPU, IPU, audio) register their own
+	 * platform devices and look clocks up by the vendor names ("isp",
+	 * "cgu_isp", "csi", ...): make every clock findable by name alone.
+	 */
+	for (i = 0; i < ARRAY_SIZE(t20_cgu_clocks); i++) {
+		struct clk *clk = cgu->clocks.clks[i];
+
+		if (!IS_ERR_OR_NULL(clk))
+			clk_register_clkdev(clk, t20_cgu_clocks[i].name, NULL);
+	}
+
+	ingenic_cgu_register_syscore(cgu);
+}
+/*
+ * CGU has some children devices, this is useful for probing children devices
+ * in the case where the device node is compatible with "simple-mfd".
+ */
+CLK_OF_DECLARE_DRIVER(t20_cgu, "ingenic,t20-cgu", t20_cgu_init);
diff --git a/include/dt-bindings/clock/ingenic,t20-cgu.h b/include/dt-bindings/clock/ingenic,t20-cgu.h
new file mode 100644
index 000000000..05ff56448
--- /dev/null
+++ b/include/dt-bindings/clock/ingenic,t20-cgu.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * This header provides clock numbers for the Ingenic T20 CGU DT binding.
+ */
+
+#ifndef __DT_BINDINGS_CLOCK_T20_CGU_H__
+#define __DT_BINDINGS_CLOCK_T20_CGU_H__
+
+#define T20_CLK_EXCLK		0
+#define T20_CLK_RTCLK		1
+#define T20_CLK_APLL		2
