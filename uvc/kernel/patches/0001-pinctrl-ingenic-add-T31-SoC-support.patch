From 3b83cd81b0b1cce224de9ea7c427b9296f753c04 Mon Sep 17 00:00:00 2001
From: Alfonso Gamboa <gtxent@gmail.com>
Date: Sun, 3 May 2026 08:38:52 -0700
Subject: [PATCH 01/10] pinctrl: ingenic: add T31 SoC support

Add the pin groups, functions and pull-up/down tables for the Ingenic
T31. Three GPIO ports (PA, PB, PC), 32 pins each, with up to four
function selects and per-pin pull-up/down register banks; layout
follows the X1830 generation.

Signed-off-by: Alfonso Gamboa <gtxent@gmail.com>
---
 drivers/pinctrl/pinctrl-ingenic.c | 125 ++++++++++++++++++++++++++++++
 1 file changed, 125 insertions(+)

diff --git a/drivers/pinctrl/pinctrl-ingenic.c b/drivers/pinctrl/pinctrl-ingenic.c
index c7f14546d..c53dec828 100644
--- a/drivers/pinctrl/pinctrl-ingenic.c
+++ b/drivers/pinctrl/pinctrl-ingenic.c
@@ -113,6 +113,7 @@ enum jz_version {
 	ID_X1500,
 	ID_X1600,
 	ID_X1830,
+	ID_T31,
 	ID_X2000,
 	ID_X2100,
 };
@@ -164,6 +165,7 @@ static const unsigned long enabled_socs =
 	IS_ENABLED(CONFIG_MACH_X1500) << ID_X1500 |
 	IS_ENABLED(CONFIG_MACH_X1600) << ID_X1600 |
 	IS_ENABLED(CONFIG_MACH_X1830) << ID_X1830 |
+	IS_ENABLED(CONFIG_MACH_T31) << ID_T31 |
 	IS_ENABLED(CONFIG_MACH_X2000) << ID_X2000 |
 	IS_ENABLED(CONFIG_MACH_X2100) << ID_X2100;
 
@@ -2824,6 +2826,125 @@ static const struct ingenic_chip_info x1830_chip_info = {
 	.access_table = &x1830_access_table,
 };
 
